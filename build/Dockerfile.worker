FROM php:8.5

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libicu-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install \
    intl \
    mysqli \
    pdo_mysql && \
    git clone --depth 1 https://github.com/phpredis/phpredis.git /tmp/phpredis && \
    cd /tmp/phpredis && \
    phpize && \
    ./configure && \
    make && \
    make install && \
    docker-php-ext-enable redis && \
    rm -rf /tmp/phpredis

COPY app /app

CMD ["php", "bin/console", "messenger:consume", "async", "--time-limit=3600", "--memory-limit=512M", "-vv"]
