FROM php:8.5

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install \
    intl \
    mysqli \
    pdo_mysql && \
    pecl install redis && \
    docker-php-ext-enable redis

COPY app /app

CMD ["php", "bin/console", "messenger:consume", "async", "--time-limit=3600", "--memory-limit=512M", "-vv"]
