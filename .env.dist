# Copy this file to .env and edit the values!
DATABASE_URL=mysql://root:secret@db:3306/app?serverVersion=8.4&charset=utf8mb4
MESSENGER_TRANSPORT_DSN=doctrine://default?table_name=messenger_messages&queue_name=default
CACHE_URL=redis://cache:6379
MYSQL_ROOT_PASSWORD=secret
MYSQL_PASSWORD=secret

# Strava
# see: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/exchange-token