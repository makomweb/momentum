{% extends "base.html.twig" %}

{% block title %}Momentum - Activities{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<div class="flex-grow space-y-4 p-4">
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold">{{ 'activities.index.title'|trans }}</h2>
        <button class="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded text-sm font-semibold" id="syncButton" onclick="handleSync()">
            <span id="syncIcon">↻</span>
            <span id="syncText">{{ 'activities.index.sync_button'|trans }}</span>
        </button>
    </div>

    {% if not is_configured %}
        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 flex gap-3">
            <div class="text-xl flex-shrink-0">⚠️</div>
            <div class="flex-grow">
                <p class="m-0 text-sm">
                    {{ 'activities.index.no_config'|trans }}
                    <a href="{{ path('profile_settings') }}" class="font-semibold hover:underline">{{ 'activities.index.configure_link'|trans }}</a>
                </p>
            </div>
        </div>
    {% endif %}

    <div class="{% if not is_configured %}opacity-50 pointer-events-none{% endif %}">
        {% if activities is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="activitiesContainer">
                {% for activity in activities %}
                    <div class="relative">
                        {% include 'activity/_card.html.twig' %}
                        {% if not is_configured %}
                            <div class="absolute inset-0 flex items-center justify-center bg-white/70 rounded">
                                <small class="text-gray-600 font-semibold text-center px-2">{{ 'activities.index.configure_title'|trans }}</small>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center p-12">
                <div class="text-5xl mb-3 opacity-50">📭</div>
                <h3 class="text-lg font-semibold mb-1">{{ 'activities.index.no_activities'|trans }}</h3>
                <p class="text-gray-600 mb-4 text-sm">{{ 'activities.index.no_activities_help'|trans }}</p>
                <button class="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded text-sm font-medium" onclick="handleSync()">
                    {{ 'activities.index.sync_now'|trans }}
                </button>
            </div>
        {% endif %}
    </div>
</div>

{% include 'components/_footer.html.twig' %}

<script>
    async function handleSync() {
        const button = document.getElementById('syncButton');
        const icon = document.getElementById('syncIcon');
        const text = document.getElementById('syncText');

        button.disabled = true;
        icon.classList.add('animate-spin');
        text.textContent = '{{ 'activities.index.syncing'|trans }}';

        try {
            // Trigger sync
            const syncResponse = await fetch('/sync', { method: 'POST' });
            
            if (!syncResponse.ok) {
                throw new Error('Failed to start sync');
            }

            const data = await syncResponse.json();
            const jobId = data.jobId;

            // Listen for completion via SSE
            const eventSource = new EventSource(`/sync/status/${jobId}`);

            eventSource.addEventListener('sync-complete', () => {
                eventSource.close();
                // Reload page to show new activities
                window.location.reload();
            });

            eventSource.onerror = () => {
                eventSource.close();
                button.disabled = false;
                icon.classList.remove('animate-spin');
                text.textContent = '{{ 'activities.index.sync_button'|trans }}';
            };
        } catch (error) {
            console.error('Sync error:', error);
            button.disabled = false;
            icon.classList.remove('animate-spin');
            text.textContent = '{{ 'activities.index.sync_button'|trans }}';
        }
    }
</script>
{% endblock %}
