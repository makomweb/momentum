<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Momentum - Activities</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    {% include 'components/_header.html.twig' %}

    <div>
        <div class="flex items-center justify-between p-6 border-b">
            <h2 class="text-2xl font-bold">Recent Activities <span id="activityCount" class="text-gray-600">(20)</span></h2>
            <button class="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded text-sm font-semibold" id="syncButton" onclick="syncActivities()">
                <span id="syncIcon">↻</span>
                <span id="syncText">Sync from Strava</span>
            </button>
        </div>

        {% if not isConfigured %}
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 flex gap-3">
                <div class="text-xl flex-shrink-0">⚠️</div>
                <div class="flex-grow">
                    <p class="m-0 text-sm">
                        Please configure your profile to analyze activities.
                        <a href="{{ path('profile_settings') }}" class="font-semibold hover:underline">Configure now →</a>
                    </p>
                </div>
            </div>
        {% endif %}

        <div class="{% if not isConfigured %}opacity-50 pointer-events-none{% endif %}">
            {% if activities is not empty %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-6" id="activitiesContainer">
                    {% for activity in activities %}
                        <div class="relative">
                            {% include 'activity/_card.html.twig' %}
                            {% if not isConfigured %}
                                <div class="absolute inset-0 flex items-center justify-center bg-white/70 rounded">
                                    <small class="text-gray-600 font-semibold text-center px-2">Configure profile to analyze</small>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center p-12">
                    <div class="text-5xl mb-3 opacity-50">📭</div>
                    <h3 class="text-lg font-semibold mb-1">No activities yet</h3>
                    <p class="text-gray-600 mb-4 text-sm">Click the "Sync from Strava" button to fetch your activities</p>
                    <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded text-sm font-medium" onclick="syncActivities()">
                        Sync Now
                    </button>
                </div>
            {% endif %}
        </div>
    </div>

    <div id="toastContainer" class="fixed top-0 right-0 p-4 space-y-2 pointer-events-none"></div>

    <script>
        async function syncActivities() {
            const button = document.getElementById('syncButton');
            const icon = document.getElementById('syncIcon');
            const text = document.getElementById('syncText');

            button.disabled = true;
            icon.style.display = 'inline-block';
            icon.classList.add('animate-spin');
            text.textContent = 'Syncing...';

            showToast('Sync started in background', 'success');

            try {
                const response = await fetch('/sync', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                if (!response.ok) {
                    throw new Error('Sync failed');
                }

                setTimeout(async () => {
                    await refreshActivities();
                    showToast('Activities synced successfully!', 'success');
                }, 2000);

            } catch (error) {
                showToast('Error syncing activities. Please try again.', 'error');
                console.error('Sync error:', error);
            } finally {
                button.disabled = false;
                icon.classList.remove('animate-spin');
                icon.style.display = 'inline';
                text.textContent = 'Sync from Strava';
            }
        }

        async function refreshActivities() {
            try {
                const response = await fetch('/api/activities/recent');
                const activities = await response.json();

                const container = document.getElementById('activitiesContainer');
                
                if (activities.length === 0) {
                    container.innerHTML = `
                        <div class="col-span-full text-center p-12">
                            <div class="text-5xl mb-3 opacity-50">📭</div>
                            <h3 class="text-lg font-semibold mb-1">No activities yet</h3>
                            <p class="text-gray-600 text-sm">Click the "Sync from Strava" button to fetch your activities</p>
                        </div>
                    `;
                    document.getElementById('activityCount').textContent = '';
                    return;
                }

                location.reload();

            } catch (error) {
                console.error('Error refreshing activities:', error);
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const bgColors = {
                success: 'bg-green-500',
                error: 'bg-red-500',
                info: 'bg-blue-500'
            };

            const icons = {
                success: '✓',
                error: '✕',
                info: 'ℹ'
            };

            toast.className = `${bgColors[type]} text-white px-4 py-3 rounded shadow-lg flex items-center gap-2 animate-in fade-in slide-in-from-top-4 duration-300 pointer-events-auto`;
            toast.innerHTML = `<span>${icons[type]}</span><span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('animate-in');
                toast.classList.add('animate-out', 'fade-out', 'slide-out-to-top-4', 'duration-300');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function updateActivityCount() {
            const count = document.querySelectorAll('[data-activity-card]').length;
            const countEl = document.getElementById('activityCount');
            if (count > 0) {
                countEl.textContent = `(${count})`;
            }
        }

        document.addEventListener('DOMContentLoaded', updateActivityCount);
    </script>
</body>
</html>
