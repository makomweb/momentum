{% extends "base.html.twig" %}

{% block title %}Momentum - Activity - No Stream{% endblock %}

{% block body_class %}class="bg-gray-50"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<div class="max-w-2xl mx-auto px-4 py-12">
    <div class="bg-white rounded-lg shadow p-8 text-center space-y-4">
        <div class="text-6xl mb-4">📊</div>
        <h2 class="text-2xl font-bold text-gray-900">No Stream Data Available</h2>
        <div class="inline-block px-4 py-2 bg-gray-100 rounded-lg font-semibold text-gray-900 mb-2">
            {{ activity_name }}
        </div>
        <p class="text-gray-600 text-lg">This activity doesn't have stream data yet, or there was an error fetching it.</p>
        <p class="text-gray-500 text-sm">Stream data includes velocity, heart rate, and elevation information over time.</p>

        <div class="bg-gray-100 rounded-lg p-6 text-left my-6">
            <p class="font-semibold text-gray-900 mb-3">Try fetching the stream data:</p>
            <code class="block bg-white p-3 rounded border border-gray-200 font-mono text-sm text-gray-700 overflow-x-auto">
                docker compose exec app bin/console app:stream &lt;ACTIVITY_ID&gt;
            </code>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="{{ path('activity_analysis') }}" class="inline-block px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition">
                Retry
            </a>
            <a href="{{ path('activities_index') }}" class="inline-block px-6 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-medium transition">
                Back to Dashboard
            </a>
        </div>
    </div>
</div>
{% endblock %}
