{% extends "base.html.twig" %}

{% block title %}Momentum - Activity - Empty{% endblock %}

{% block body_class %}class="bg-gray-50"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<div class="max-w-2xl mx-auto px-4 py-12">
    <div class="bg-white rounded-lg shadow p-8 text-center space-y-4">
        <div class="text-6xl mb-4">📭</div>
        <h2 class="text-2xl font-bold text-gray-900">No Activities Found</h2>
        <p class="text-gray-600 text-lg">You haven't synced any activities yet. Start by fetching your Strava activities using the commands below.</p>
        
        <div class="bg-gray-100 rounded-lg p-6 text-left my-6 space-y-2">
            <p class="font-semibold text-gray-900 mb-3">To get started, run:</p>
            <code class="block bg-white p-3 rounded border border-gray-200 font-mono text-sm text-gray-700 mb-2 overflow-x-auto">
                docker compose exec app bin/console app:activities &lt;STRAVA_USER_ID&gt;
            </code>
            <code class="block bg-white p-3 rounded border border-gray-200 font-mono text-sm text-gray-700 overflow-x-auto">
                docker compose exec app bin/console app:stream &lt;ACTIVITY_ID&gt; -u &lt;STRAVA_USER_ID&gt;
            </code>
        </div>

        <a href="{{ path('activities_index') }}" class="inline-block px-6 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-medium transition">
            Back to Dashboard
        </a>
    </div>
</div>
{% endblock %}
