<div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 h-full overflow-hidden">
        <div class="bg-gray-100 border-b border-gray-200 p-4">
            <h3 class="font-semibold text-gray-900 m-0">Pace Zones</h3>
        </div>
        <div class="p-4 space-y-3">
            {% for stat in paceStats %}
                {% set zone = stat.zone %}
                {% set percentage = stat.duration_percentage %}
                <div class="space-y-1">
                    <div class="flex justify-between items-center">
                        <div class="font-medium text-gray-900">{{ zone }}</div>
                        <div class="text-gray-600 text-sm">{{ percentage | number_format(1, '.') }}%</div>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style="width: {{ percentage }}%; background: {{ zone | format_zone_color('pace') }};"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
