<div class="grid grid-cols-3 gap-2">
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Distance</div>
        <div class="text-sm font-bold">
            {% if metaData.getData()['distance'] is not null %}
                {{ (metaData.getData()['distance'].getMeters() / 1000) | number_format(1, '.') }} km
            {% else %}
                N/A
            {% endif %}
        </div>
    </div>
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Avg. {{ metaData.getLabel() }}</div>
        <div class="text-sm font-bold">
            {% if metaData.getData()['average_velocity'] is not null %}
                {{ metaData.getData()['average_velocity'] }}
            {% else %}
                N/A
            {% endif %}
        </div>
    </div>
    {% if activityData.hasVelocityData() %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Max. {{ metaData.getLabel() }}</div>
        <div class="text-sm font-bold">{{ activityData.getVelocityMax() | format_velocity(metaData.getActivityType()) }}</div>
    </div>
    {% endif %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Moving Time</div>
        <div class="text-sm font-bold">{{ metaData.getMovingTime() | format_moving_time }}</div>
    </div>
    {% if activityData.hasHeartRateData() %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Avg. Heart Rate</div>
        <div class="text-sm font-bold">{{ activityData.getHeartRateAverage() }} bpm</div>
    </div>
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">Max. Heart Rate</div>
        <div class="text-sm font-bold">{{ activityData.getHeartRateMax() }} bpm</div>
    </div>
    {% endif %}
</div>
