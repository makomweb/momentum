<div class="grid grid-cols-3 gap-2">
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">{{ 'activity.distance'|trans }}</div>
        <div class="text-sm font-bold">
            {{ meta_data.getDistance() }}
        </div>
    </div>
    {% if meta_data.hasVelocity() %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">{{ 'activity.avg'|trans }} {{ meta_data.getLabel() }}</div>
        <div class="text-sm font-bold">
            {{ meta_data.getAverageVelocity() }}
        </div>
    </div>
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">{{ 'activity.max'|trans }} {{ meta_data.getLabel() }}</div>
        <div class="text-sm font-bold">{{ activity_data.getVelocityMax() | format_velocity(meta_data.getActivityType()) }}</div>
    </div>
    {% endif %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600">{{ 'activity.moving_time'|trans }}</div>
        <div class="text-sm font-bold">{{ meta_data.getMovingTime() | format_moving_time }}</div>
    </div>
    {% if activity_data.hasHeartRateData() %}
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600 truncate">{{ 'activity.avg_heart_rate'|trans }}</div>
        <div class="text-sm font-bold">{{ activity_data.getHeartRateAverage() }} bpm</div>
    </div>
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600 truncate">{{ 'activity.max_heart_rate'|trans }}</div>
        <div class="text-sm font-bold">{{ activity_data.getHeartRateMax() }} bpm</div>
    </div>
    <div class="flex flex-col gap-1 bg-white border border-gray-200 rounded p-2">
        <div class="text-xs font-semibold text-gray-600 truncate">{{ 'activity.avg_power'|trans }}</div>
        <div class="text-sm font-bold">{{ activity_data.getPowerAverage() }}</div>
    </div>
    {% endif %}
</div>
