<div class="bg-white border border-gray-200 rounded p-4 flex flex-col h-full overflow-hidden" style="max-height: 15rem;">
    <h3 class="text-sm font-semibold mb-3 flex-shrink-0">{{ 'activity.heart_rate_zones'|trans }}</h3>
    <div class="space-y-2 overflow-y-auto flex-grow">
        {% for stat in hr_stats %}
            {% set zone = stat.zone %}
            {% set description = stat.description %}
            {% set percentage = stat.duration_percentage %}
            <div>
                <div class="flex justify-between items-start mb-1">
                    <div class="text-xs font-semibold">{{ description }}</div>
                    <div class="text-xs font-bold" style="color: {{ zone | zone_color }};">{{ percentage | number_format(1, '.') }}%</div>
                </div>
                <div class="w-full bg-gray-200 rounded h-1.5">
                    <div class="h-full rounded" style="width: {{ percentage }}%; background: {{ zone | zone_color }};"></div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
