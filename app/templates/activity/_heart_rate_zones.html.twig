<div class="border-l-4 border-gray-300 p-4">
    <h3 class="font-semibold mb-3 text-sm">Heart Rate Zones</h3>
    <div class="space-y-2">
        {% for stat in hrStats %}
            {% set zone = stat.zone %}
            {% set percentage = stat.duration_percentage %}
            <div>
                <div class="flex justify-between items-center mb-1 text-xs">
                    <div class="font-medium">{{ zone }}</div>
                    <div class="text-gray-600">{{ percentage | number_format(1, '.') }}%</div>
                </div>
                <div class="w-full bg-gray-200 rounded h-1.5">
                    <div class="h-full rounded" style="width: {{ percentage }}%; background: {{ zone | format_zone_color('hr') }};"></div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
