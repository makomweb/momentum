<div class="zone-card">
    <div class="zone-card-header">
        <h3 class="zone-card-title">❤️ Heart Rate Zones</h3>
    </div>
    <div class="zone-card-body">
        <div class="zone-list">
            {% for stat in hrStats %}
                {% set zone = stat.zone %}
                {% set percentage = stat.duration_percentage %}
                <div class="zone-row">
                    <div class="zone-name">{{ zone }}</div>
                    <div class="zone-bar">
                        <div class="zone-bar-fill" style="width: {{ percentage }}%; background: {{ zone | zone_color('hr') }};"></div>
                    </div>
                    <div class="zone-percentage">{{ percentage | number_format(1, '.') }}%</div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
