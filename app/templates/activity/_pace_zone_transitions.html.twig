<div class="border-l-4 border-gray-300 p-4 space-y-2">
    <h3 class="font-semibold mb-3 text-sm">Pace Zone Transitions</h3>
    {% for session in paceZoneSessions %}
        <div class="flex items-center justify-between gap-3 p-2 border-l-4 text-xs" style="background: {{ session.zone.getColor() }}11; border-left-color: {{ session.zone.getColor() }};">
            <div class="font-semibold" style="color: {{ session.zone.getColor() }};">{{ session.zone.value }}</div>
            <div class="text-gray-600">
                <small>{{ session.start | format_local_date_time('H:i:s') }}</small>
                <small class="mx-1">→</small>
                <small>{{ '%02d:%02d' | format((session.seconds // 60), (session.seconds % 60)) }}</small>
            </div>
        </div>
    {% endfor %}
</div>
