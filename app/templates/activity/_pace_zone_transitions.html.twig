<div class="timeline-card">
    <div class="timeline-card-header">
        <h3 class="timeline-title">⏱ Pace Zone Transitions</h3>
    </div>
    <div class="timeline-card-body">
        <div class="timeline-list">
            {% for session in paceZoneSessions %}
                <div class="timeline-item" style="background: {{ session.zone.getColor() }}22; border-left: 3px solid {{ session.zone.getColor() }};">
                    <div class="timeline-zone" style="color: {{ session.zone.getColor() }};">{{ session.zone.value }}</div>
                    <div class="timeline-meta">
                        <span>{{ session.start | local_date('H:i:s') }}</span>
                        <span>→ {{ '%02d:%02d' | format((session.seconds // 60), (session.seconds % 60)) }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
