<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Activity Analysis - Momentum</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50">
    {% include 'components/_header.html.twig' %}

    <div class="max-w-6xl mx-auto px-4 py-4 space-y-4">
        <!-- Activity Header Card -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Left Column: Title and Stats -->
                <div class="lg:col-span-2">
                    <!-- Activity Title -->
                    <div class="mb-6">
                        <h1 class="text-2xl font-bold text-gray-900 mb-2">{{ metaData.getActivityName() }}</h1>
                        <small class="text-gray-600 flex gap-2 items-center">
                            <span>{{ metaData.getStartDateLocalTimeFormatted() }}</span>
                        </small>
                    </div>

                    <!-- Stat Boxes Grid -->
                    <div class="grid grid-cols-3 gap-4">
                        <div class="bg-gray-50 rounded-lg p-4">
                            <div class="text-gray-600 text-xs uppercase font-semibold tracking-wide mb-2">Distance</div>
                            <div class="text-lg font-bold text-gray-900">
                                {% if metaData.getData()['distance'] is not null %}
                                    {{ (metaData.getData()['distance'].getMeters() / 1000) | number_format(1, '.') }} km
                                {% else %}
                                    <span class="opacity-50">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-4">
                            <div class="text-gray-600 text-xs uppercase font-semibold tracking-wide mb-2">Moving Time</div>
                            <div class="text-lg font-bold text-gray-900">{{ metaData.getMovingTime() | format_moving_time }}</div>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-4">
                            <div class="text-gray-600 text-xs uppercase font-semibold tracking-wide mb-2">Avg. {{ metaData.getLabel() }}</div>
                            <div class="text-lg font-bold text-gray-900">
                                {% if metaData.getData()['average_velocity'] is not null %}
                                    {{ metaData.getData()['average_velocity'] }}
                                {% else %}
                                    <span class="opacity-50">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Additional Stats -->
                <div class="bg-gray-50 rounded-lg p-4 space-y-4">
                    {% if activityData.hasHeartRateData() %}
                    <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                        <span class="text-gray-600 text-sm">Avg. Heart Rate</span>
                        <span class="font-semibold text-gray-900">{{ activityData.getHeartRateAverage() }} bpm</span>
                    </div>
                    {% endif %}

                    {% if activityData.hasHeartRateData() %}
                    <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                        <span class="text-gray-600 text-sm">Max. Heart Rate</span>
                        <span class="font-semibold text-gray-900">{{ activityData.getHeartRateMax() }} bpm</span>
                    </div>
                    {% endif %}

                    {% if activityData.hasVelocityData() %}
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 text-sm">Max. {{ metaData.getLabel() }}</span>
                        <span class="font-semibold text-gray-900">{{ activityData.getVelocityMax() | format_velocity(metaData.getActivityType()) }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Zone Analysis and Charts Card -->
        <div class="bg-white rounded-lg shadow p-6 space-y-6">
            <div>
                <h2 class="text-xl font-bold text-gray-900 mb-3">Training Zones</h2>
                <p class="text-sm text-gray-600">
                    <span class="font-semibold">Zone Validation:</span>
                    Hard zones (Threshold, VO2max) are confirmed by heart rate data to eliminate false positives from brief pace spikes. Only confirmed zones feed the training calculations.
                </p>
            </div>

            <!-- Zone Layout -->
            {% if metaData.usesPaceZones() and paceZoneSessions | length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% if metaData.isRun() %}
                        <div>
                            {% include 'activity/_metrics.html.twig' with { metrics: metrics } %}
                        </div>
                    {% endif %}
                    {% include 'activity/_heart_rate_zones.html.twig' with { hrStats: hrStats } %}
                    {% include 'activity/_pace_zones.html.twig' with { paceStats: paceStats } %}
                    <div>
                        {% include 'activity/_pace_zone_transitions.html.twig' with { paceZoneSessions: paceZoneSessions } %}
                    </div>
                </div>

            {% elseif not metaData.usesPaceZones() and heartRateZoneSessions | length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% include 'activity/_heart_rate_zones.html.twig' with { hrStats: hrStats } %}
                    {% if metaData.isRun() %}
                        <div>
                            {% include 'activity/_metrics.html.twig' with { metrics: metrics } %}
                        </div>
                    {% endif %}
                </div>

            {% elseif app.user.getTreshold().isZero() %}
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg">
                    To see zone analysis, please configure your threshold pace in your profile settings.
                </div>
            {% endif %}

            <!-- Data Availability Alerts -->
            {% if not activityData.hasAnyData() %}
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg">
                    No data available for analysis. This activity may not have complete stream data.
                </div>
            {% else %}
                <!-- Velocity Chart -->
                {% if activityData.hasVelocityData() %}
                    <div class="bg-white rounded-lg border border-gray-200 p-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-4">{{ metaData.getVelocityChartTitle() }}</h3>
                        <div class="h-96">
                            <canvas id="velocityChart"></canvas>
                        </div>
                    </div>
                {% else %}
                    <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded-lg">
                        Velocity data not available for this activity.
                    </div>
                {% endif %}

                <!-- Heart Rate Chart -->
                {% if activityData.hasHeartRateData() %}
                    <div class="bg-white rounded-lg border border-gray-200 p-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-4">Heart Rate Over Time</h3>
                        <div class="h-96">
                            <canvas id="heartRateChart"></canvas>
                        </div>
                    </div>
                {% else %}
                    <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded-lg">
                        Heart rate data not available for this activity.
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <script>
        // Custom Chart.js plugin to draw zone backgrounds
        const zoneBackgroundPlugin = {
            id: 'zoneBackground',
            afterDatasetsDraw(chart) {
                if (!chart.data.zoneColors || chart.data.zoneColors.length === 0) {
                    return;
                }

                const ctx = chart.ctx;
                const xScale = chart.scales.x;
                const yScale = chart.scales.y;
                const chartArea = chart.chartArea;

                // Get all labels (timestamps)
                const labels = chart.data.labels;

                chart.data.zoneColors.forEach(zone => {
                    // Find start and end indices
                    const startIdx = labels.findIndex(label => label >= zone.startTime);
                    const endIdx = labels.findIndex(label => label > zone.endTime);
                    
                    if (startIdx === -1) return;
                    
                    // Calculate pixel positions
                    const startPixel = startIdx < labels.length 
                        ? xScale.getPixelForValue(startIdx)
                        : chartArea.left;
                    const endPixel = endIdx === -1 
                        ? chartArea.right
                        : xScale.getPixelForValue(endIdx);

                    // Draw semi-transparent zone background
                    ctx.save();
                    ctx.fillStyle = zone.color + '44'; // Add alpha channel (44 hex = ~0.27 opacity)
                    ctx.fillRect(
                        Math.max(startPixel, chartArea.left),
                        chartArea.top,
                        Math.min(endPixel, chartArea.right) - Math.max(startPixel, chartArea.left),
                        chartArea.bottom - chartArea.top
                    );

                    // Draw zone label
                    if (endPixel - startPixel > 40) { // Only show label if space available
                        ctx.fillStyle = zone.color;
                        ctx.font = '11px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(
                            zone.name,
                            (Math.max(startPixel, chartArea.left) + Math.min(endPixel, chartArea.right)) / 2,
                            chartArea.top + 15
                        );
                    }
                    ctx.restore();
                });
            }
        };
        
        // Register the zone background plugin
        Chart.register(zoneBackgroundPlugin);
        
        {% if activityData.hasVelocityData() %}
        const velocityCtx = document.getElementById('velocityChart').getContext('2d');
        const velocityData = {
            labels: [
                {% for point in activityData.getVelocityRawPoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [
                {
                    label: 'Velocity',
                    data: [
                        {% for point in activityData.getVelocityRawPoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: 'rgba(102, 126, 234, 0.5)',
                    backgroundColor: 'rgba(102, 126, 234, 0.08)',
                    borderWidth: 1.5,
                    tension: 0.4,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 6
                },
                {
                    label: 'EMA-{{ activityData.getMovingAveragePeriod() }}',
                    data: [
                        {% for point in activityData.getVelocityAveragePoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: '#e74c3c',
                    backgroundColor: 'rgba(231, 76, 60, 0)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: false,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }
            ]
        };
        
        {% if metaData.usesPaceZones() and paceZoneSessions | length > 0 %}
            velocityData.zoneColors = [
                {% for session in paceZoneSessions %}
                    {
                        name: '{{ session.zone.value }}',
                        startTime: '{{ session.start.format('H:i:s') }}',
                        endTime: '{{ session.end.format('H:i:s') }}',
                        color: '{{ session.zone.getColor() }}'
                    }{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ];
        {% endif %}

        new Chart(velocityCtx, {
            type: 'line',
            data: velocityData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    },
                    zoneBackground: {}
                },
                scales: {
                    y: {
                        {% if metaData.useInverseScale() %}
                        reverse: true,
                        min: {{ metaData.getChartYAxisMinValue() }},
                        max: {{ metaData.getChartYAxisMaxValue() }},
                        {% else %}
                        min: 0,
                        {% endif %}
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: '{{ metaData.getChartYAxisLabel() }}',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}

        {% if activityData.hasHeartRateData() %}
        const heartRateCtx = document.getElementById('heartRateChart').getContext('2d');
        const heartRateData = {
            labels: [
                {% for point in activityData.getHeartRatePoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [{
                label: 'Heart Rate (bpm)',
                data: [
                    {% for point in activityData.getHeartRatePoints() %}
                        {{ point.value }}{{ not loop.last ? ',' : '' }}
                    {% endfor %}
                ],
                borderColor: '#e74c3c',
                backgroundColor: 'rgba(231, 76, 60, 0.1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointRadius: 0,
                pointHoverRadius: 6
            }]
        };
        
        {% if heartRateZoneSessions | length > 0 %}
            heartRateData.zoneColors = [
                {% for session in heartRateZoneSessions %}
                    {
                        name: '{{ session.zone.value }}',
                        startTime: '{{ session.start.format('H:i:s') }}',
                        endTime: '{{ session.end.format('H:i:s') }}',
                        color: '{{ session.zone.getColor() }}'
                    }{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ];
        {% endif %}

        new Chart(heartRateCtx, {
            type: 'line',
            data: heartRateData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    },
                    zoneBackground: {}
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Heart Rate (bpm)',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}
    </script>
</body>
</html>
