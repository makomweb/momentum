<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Activity Analysis - Momentum</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
            padding-top: 0;
        }

        .container-custom {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .activity-header {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.7) 0%, rgba(118, 75, 162, 0.7) 100%);
            color: white;
            padding: 1.25rem 1.5rem;
            border-radius: 12px;
            margin-top: 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.12);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .activity-header-content {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.9fr);
            gap: 1rem;
            align-items: stretch;
        }

        .activity-left-column {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .activity-right-column {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .activity-title {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0;
        }

        .activity-title-content {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .activity-emoji {
            font-size: 1.75rem;
            flex-shrink: 0;
            margin-top: 0.15rem;
        }

        .activity-name {
            font-size: 1.55rem;
            font-weight: 700;
            margin: 0;
            line-height: 1.2;
        }

        .activity-datetime {
            font-size: 0.9rem;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .activity-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
        }

        .stats-panel {
            background: rgba(255, 255, 255, 0.06);
            padding: 0.55rem 0.75rem;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 0.1rem;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.35rem 0;
            flex: 1;
            align-self: stretch;
            gap: 1rem;
        }

        .stat-row-separator {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.08);
            padding: 0.7rem 0.8rem;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            transition: all 0.3s ease;
        }

        .stat-box:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.18);
            transform: translateY(-2px);
        }

        .stat-label {
            font-size: 0.7rem;
            opacity: 0.7;
            margin-bottom: 0.2rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .stat-value {
            font-size: 1.15rem;
            font-weight: 600;
            line-height: 1;
        }

        .stat-row-label {
            font-size: 0.75rem;
            opacity: 0.75;
        }

        .stat-row-value {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .chart-container {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .zone-analysis-panel {
            padding: 1.5rem 1.5rem 1.25rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(102, 126, 234, 0.12);
            box-shadow: 0 10px 28px rgba(102, 126, 234, 0.12);
        }

        .zone-analysis-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .zone-analysis-kicker {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #667eea;
            margin-bottom: 0.35rem;
        }

        .zone-analysis-subtitle {
            margin: 0;
            color: #667085;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        .zone-analysis-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.9fr);
            gap: 1.25rem;
            align-items: start;
        }

        .zone-analysis-main {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .zone-summary-card {
            background: white;
            border-radius: 14px;
            border: 1px solid #e6ebf2;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }

        .zone-summary-card--balanced {
            border-color: rgba(76, 175, 80, 0.3);
            box-shadow: 0 4px 20px rgba(76, 175, 80, 0.14);
        }

        .zone-summary-card--unbalanced {
            border-color: rgba(255, 152, 0, 0.3);
            box-shadow: 0 4px 20px rgba(255, 152, 0, 0.14);
        }

        .zone-summary-header {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.8rem 1.1rem;
            border-bottom: 1px solid #f0f2f5;
        }

        .zone-summary-card--balanced .zone-summary-header {
            background: linear-gradient(135deg, #f1f8f1 0%, #e8f5e9 100%);
        }

        .zone-summary-card--unbalanced .zone-summary-header {
            background: linear-gradient(135deg, #fffbf2 0%, #fff3e0 100%);
        }

        .zone-summary-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            letter-spacing: 0.03em;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .zone-summary-card--balanced .zone-summary-badge {
            background: rgba(76, 175, 80, 0.12);
            color: #2e7d32;
            border: 1px solid rgba(76, 175, 80, 0.35);
        }

        .zone-summary-card--unbalanced .zone-summary-badge {
            background: rgba(255, 152, 0, 0.12);
            color: #b45309;
            border: 1px solid rgba(255, 152, 0, 0.35);
        }

        .zone-summary-hint {
            font-size: 0.8rem;
            color: #667085;
            line-height: 1.35;
        }

        .zone-summary-body {
            padding: 1rem 1rem;
        }

        .zone-summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.65rem;
        }

        .zone-summary-metric-inner {
            background: #f8fafc;
            border: 1px solid #e6ebf2;
            border-radius: 10px;
            padding: 0.75rem 0.5rem 0.65rem;
            text-align: center;
        }

        .zone-summary-label {
            font-size: 0.66rem;
            color: #8892a4;
            margin-bottom: 0.45rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 600;
        }

        .zone-summary-value {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 0.55rem;
        }

        .zone-summary-bar {
            height: 5px;
            background: #eaecf0;
            border-radius: 3px;
            overflow: hidden;
            margin: 0 0.1rem;
        }

        .zone-summary-bar-fill {
            height: 100%;
            border-radius: 3px;
            opacity: 0.85;
        }

        .zone-columns {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .zone-card {
            background: white;
            border: 1px solid #e6ebf2;
            border-radius: 14px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }

        .zone-card-header {
            padding: 0.8rem 1.1rem;
            background: #f8fafc;
            border-bottom: 1px solid #f0f2f5;
        }

        .zone-card-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #333;
            margin: 0;
        }

        .zone-card-body {
            padding: 1rem 1.1rem;
        }

        .zone-list {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .zone-row {
            display: grid;
            grid-template-columns: minmax(70px, auto) minmax(0, 1fr) 52px;
            align-items: center;
            gap: 0.6rem;
        }

        .zone-name {
            font-size: 0.84rem;
            font-weight: 600;
            color: #666;
        }

        .zone-bar {
            background: #e0e0e0;
            border-radius: 999px;
            height: 12px;
            overflow: hidden;
            position: relative;
        }

        .zone-bar-fill {
            height: 100%;
            border-radius: 999px;
            transition: width 0.3s ease;
        }

        .zone-percentage {
            font-size: 0.8rem;
            color: #8a8f98;
            text-align: right;
        }

        .zone-analysis-side {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .zone-analysis-note {
            font-size: 0.88rem;
            color: #667085;
            line-height: 1.5;
            margin-top: 0.3rem;
        }

        .zone-analysis-note-label {
            font-weight: 600;
            color: #4a5568;
            margin-right: 0.35rem;
        }

        .timeline-card {
            background: white;
            border: 1px solid #e6ebf2;
            border-radius: 14px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }

        .timeline-card-header {
            padding: 0.8rem 1.1rem;
            background: #f8fafc;
            border-bottom: 1px solid #f0f2f5;
        }

        .timeline-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #333;
            margin: 0;
        }

        .timeline-card-body {
            padding: 0.5rem;
        }

        .timeline-list {
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
            max-height: 320px;
            overflow-y: auto;
        }

        .timeline-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.55rem 0.7rem;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .timeline-zone {
            font-weight: 600;
        }

        .timeline-meta {
            display: flex;
            gap: 0.6rem;
            color: #666;
            white-space: nowrap;
            margin-left: auto;
        }

        .chart-container:hover {
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        }

        .chart-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: #333;
        }

        .chart-wrapper {
            position: relative;
            height: 450px;
            margin-bottom: 1rem;
        }

        .alert-message {
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 1rem;
            font-weight: 500;
        }

        .alert-info {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            color: #1565c0;
            border-left: 4px solid #667eea;
        }

        @media (max-width: 768px) {
            .activity-header {
                padding: 1.5rem;
            }

            .activity-header-content {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .activity-name {
                font-size: 1.5rem;
            }

            .activity-emoji {
                font-size: 1.5rem;
            }

            .activity-stats {
                grid-template-columns: 1fr 1fr;
            }

            .zone-analysis-layout,
            .zone-columns,
            .zone-summary-grid {
                grid-template-columns: 1fr;
            }

            .zone-analysis-header {
                flex-direction: column;
            }

            .chart-wrapper {
                height: 300px;
            }

            .container-custom {
                padding: 0 1rem;
            }
        }
    </style>
</head>
<body>
    {% include 'components/_header.html.twig' %}

    <div class="container-custom">
        <div class="activity-header">
            <div class="activity-header-content">
                <div class="activity-left-column">
                    <div class="activity-title">
                        <span class="activity-emoji">{{ metaData.getEmoji() }}</span>
                        <div class="activity-title-content">
                            <h1 class="activity-name">{{ metaData.getActivityName() }}</h1>
                            <div class="activity-datetime">
                                <span>{{ metaData.getStartDateLocalTimeFormatted() }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="activity-stats">
                        <div class="stat-box">
                            <div class="stat-label">Distance</div>
                            <div class="stat-value">
                                {% if metaData.getData()['distance'] is not null %}
                                    {{ (metaData.getData()['distance'].getMeters() / 1000) | number_format(1, '.') }} km
                                {% else %}
                                    <span style="opacity: 0.5;">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-label">Duration</div>
                            <div class="stat-value">{{ metaData.getMovingTimeAsString() }}</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-label">Avg. {{ metaData.getLabel() }}</div>
                            <div class="stat-value">
                                {% if metaData.getData()['average_velocity'] is not null %}
                                    {{ metaData.getData()['average_velocity'] }}
                                {% else %}
                                    <span style="opacity: 0.5;">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="activity-right-column">
                    <div class="stats-panel">
                        {% if activityData.hasHeartRateData() %}
                        <div class="stat-row stat-row-separator">
                            <span class="stat-row-label">Avg. Heart Rate</span>
                            <span class="stat-row-value">{{ activityData.getHeartRateAverage() }} bpm</span>
                        </div>
                        {% endif %}

                        {% if activityData.hasHeartRateData() %}
                        <div class="stat-row stat-row-separator">
                            <span class="stat-row-label">Max. Heart Rate</span>
                            <span class="stat-row-value">{{ activityData.getHeartRateMax() }} bpm</span>
                        </div>
                        {% endif %}

                        {% if activityData.hasVelocityData() %}
                        <div class="stat-row">
                            <span class="stat-row-label">Max. {{ metaData.getLabel() }}</span>
                            <span class="stat-row-value">{{ activityData.getVelocityMax() | format_velocity(metaData.getActivityType()) }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if zoneAnalysis %}
            {% set paceStats = zoneAnalysis.getPaceZoneStatistics() %}
            {% set hrStats = zoneAnalysis.getHeartRateZoneStatistics() %}
            {% set metrics = zoneAnalysis.getTrainingMetrics() %}
            <div class="chart-container zone-analysis-panel">
                <div class="zone-analysis-header">
                    <div>
                        <div class="zone-analysis-kicker">Priority insight</div>
                        <div class="chart-title" style="margin-bottom: 0.35rem;">🎯 Training Zones</div>
                        <p class="zone-analysis-note"><span class="zone-analysis-note-label">Zone Validation</span>Hard zones (Threshold, VO2max) are confirmed by heart rate data to eliminate false positives from brief pace spikes. Only confirmed zones feed the training calculations.</p>
                    </div>
                </div>

                <div class="zone-analysis-layout">
                    <div class="zone-analysis-main">
                        <div class="zone-summary-card {% if metrics.isBalanced() %}zone-summary-card--balanced{% else %}zone-summary-card--unbalanced{% endif %}">
                            <div class="zone-summary-header">
                                <span class="zone-summary-badge">
                                    {% if metrics.isBalanced() %}✅ Balanced{% else %}⚠️ Unbalanced{% endif %}
                                </span>
                                <span class="zone-summary-hint">
                                    {% if metrics.isBalanced() %}
                                        Good balance of easy aerobic base and hard quality work.
                                    {% else %}
                                        Shift more volume into easy (Z1–2) or hard (Z4–5) zones.
                                    {% endif %}
                                </span>
                            </div>
                            <div class="zone-summary-body">
                                <div class="zone-summary-grid">
                                    <div class="zone-summary-metric-inner">
                                        <div class="zone-summary-label">Easy · Z1–2</div>
                                        <div class="zone-summary-value" style="color: #2196f3;">{{ metrics.getEasyPercentage() | number_format(1, '.') }}%</div>
                                        <div class="zone-summary-bar">
                                            <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getEasyPercentage(), 100) | number_format(1, '.') }}%; background: #2196f3;"></div>
                                        </div>
                                    </div>
                                    <div class="zone-summary-metric-inner">
                                        <div class="zone-summary-label">Medium · Z3</div>
                                        <div class="zone-summary-value" style="color: #ff9800;">{{ metrics.getMediumPercentage() | number_format(1, '.') }}%</div>
                                        <div class="zone-summary-bar">
                                            <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getMediumPercentage(), 100) | number_format(1, '.') }}%; background: #ff9800;"></div>
                                        </div>
                                    </div>
                                    <div class="zone-summary-metric-inner">
                                        <div class="zone-summary-label">Hard · Z4–5</div>
                                        <div class="zone-summary-value" style="color: #f44336;">{{ metrics.getHardPercentage() | number_format(1, '.') }}%</div>
                                        <div class="zone-summary-bar">
                                            <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getHardPercentage(), 100) | number_format(1, '.') }}%; background: #f44336;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="zone-columns">
                            <div class="zone-card">
                                <div class="zone-card-header">
                                    <h3 class="zone-card-title">⏱️ Pace Zones</h3>
                                </div>
                                <div class="zone-card-body">
                                    <div class="zone-list">
                                        {% for zoneKey, stat in paceStats.statistics %}
                                            {% set zone = stat.zone %}
                                            {% set percentage = stat.getDurationPercentage() %}
                                            <div class="zone-row">
                                                <div class="zone-name">{{ zone.value }}</div>
                                                <div class="zone-bar">
                                                    <div class="zone-bar-fill" style="width: {{ percentage }}%; background: {{ zone.getColor() }};"></div>
                                                </div>
                                                <div class="zone-percentage">{{ percentage | number_format(1, '.') }}%</div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            {% if hrStats %}
                                <div class="zone-card">
                                    <div class="zone-card-header">
                                        <h3 class="zone-card-title">❤️ Heart Rate Zones</h3>
                                    </div>
                                    <div class="zone-card-body">
                                        <div class="zone-list">
                                            {% for zoneKey, stat in hrStats.statistics %}
                                                {% set zone = stat.zone %}
                                                {% set percentage = stat.getDurationPercentage() %}
                                                <div class="zone-row">
                                                    <div class="zone-name">{{ zone.value }}</div>
                                                    <div class="zone-bar">
                                                        <div class="zone-bar-fill" style="width: {{ percentage }}%; background: {{ zone.getColor() }};"></div>
                                                    </div>
                                                    <div class="zone-percentage">{{ percentage | number_format(1, '.') }}%</div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="zone-analysis-side">
                        {% if zoneAnalysis.paceZoneSessions | length > 0 %}
                            <div class="timeline-card">
                                <div class="timeline-card-header">
                                    <h3 class="timeline-title">⏱ Pace Zone Transitions</h3>
                                </div>
                                <div class="timeline-card-body">
                                    <div class="timeline-list">
                                        {% for session in zoneAnalysis.paceZoneSessions %}
                                            <div class="timeline-item" style="background: {{ session.zone.getColor() }}22; border-left: 3px solid {{ session.zone.getColor() }};">
                                                <div class="timeline-zone" style="color: {{ session.zone.getColor() }};">{{ session.zone.value }}</div>
                                                <div class="timeline-meta">
                                                    <span>{{ session.start | local_date('H:i:s') }}</span>
                                                    <span>→ {{ '%02d:%02d' | format((session.seconds // 60), (session.seconds % 60)) }}</span>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% elseif app.user.getFtp() is null %}
            <div class="alert-message alert-info" style="background: linear-gradient(135deg, #fff3cd 0%, #fff8e1 100%); color: #856404; border-left-color: #ffc107;">
                <span>⚙️</span>
                <span>To see zone analysis, please configure your FTP in your profile settings.</span>
            </div>
        {% endif %}

        {% if not activityData.hasAnyData() %}
            <div class="alert-message alert-info">
                <span>⚠️</span>
                <span>No data available for analysis. This activity may not have complete stream data.</span>
            </div>
        {% else %}
            {% if activityData.hasVelocityData() %}
                <div class="chart-container">
                    <div class="chart-title">{{ metaData.getVelocityChartTitle() }}</div>
                    <div class="chart-wrapper">
                        <canvas id="velocityChart"></canvas>
                    </div>
                </div>
            {% else %}
                <div class="alert-message alert-info">
                    <span>ℹ️</span>
                    <span>Velocity data not available for this activity.</span>
                </div>
            {% endif %}

            {% if activityData.hasHeartRateData() %}
                <div class="chart-container">
                    <div class="chart-title">❤️ Heart Rate Over Time</div>
                    <div class="chart-wrapper">
                        <canvas id="heartRateChart"></canvas>
                    </div>
                </div>
            {% else %}
                <div class="alert-message alert-info">
                    <span>ℹ️</span>
                    <span>Heart rate data not available for this activity.</span>
                </div>
            {% endif %}
        {% endif %}

    </div>

    <script>
        // Custom Chart.js plugin to draw zone backgrounds
        const zoneBackgroundPlugin = {
            id: 'zoneBackground',
            afterDatasetsDraw(chart) {
                if (!chart.data.zoneColors || chart.data.zoneColors.length === 0) {
                    return;
                }

                const ctx = chart.ctx;
                const xScale = chart.scales.x;
                const yScale = chart.scales.y;
                const chartArea = chart.chartArea;

                // Get all labels (timestamps)
                const labels = chart.data.labels;

                chart.data.zoneColors.forEach(zone => {
                    // Find start and end indices
                    const startIdx = labels.findIndex(label => label >= zone.startTime);
                    const endIdx = labels.findIndex(label => label > zone.endTime);
                    
                    if (startIdx === -1) return;
                    
                    // Calculate pixel positions
                    const startPixel = startIdx < labels.length 
                        ? xScale.getPixelForValue(startIdx)
                        : chartArea.left;
                    const endPixel = endIdx === -1 
                        ? chartArea.right
                        : xScale.getPixelForValue(endIdx);

                    // Draw semi-transparent zone background
                    ctx.save();
                    ctx.fillStyle = zone.color + '44'; // Add alpha channel (44 hex = ~0.27 opacity)
                    ctx.fillRect(
                        Math.max(startPixel, chartArea.left),
                        chartArea.top,
                        Math.min(endPixel, chartArea.right) - Math.max(startPixel, chartArea.left),
                        chartArea.bottom - chartArea.top
                    );

                    // Draw zone label
                    if (endPixel - startPixel > 40) { // Only show label if space available
                        ctx.fillStyle = zone.color;
                        ctx.font = '11px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(
                            zone.name,
                            (Math.max(startPixel, chartArea.left) + Math.min(endPixel, chartArea.right)) / 2,
                            chartArea.top + 15
                        );
                    }
                    ctx.restore();
                });
            }
        };
        
        // Register the zone background plugin
        Chart.register(zoneBackgroundPlugin);
        
        {% if activityData.hasVelocityData() %}
        const velocityCtx = document.getElementById('velocityChart').getContext('2d');
        const velocityData = {
            labels: [
                {% for point in activityData.getVelocityRawPoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [
                {
                    label: 'Velocity',
                    data: [
                        {% for point in activityData.getVelocityRawPoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: 'rgba(102, 126, 234, 0.5)',
                    backgroundColor: 'rgba(102, 126, 234, 0.08)',
                    borderWidth: 1.5,
                    tension: 0.4,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 6
                },
                {
                    label: 'EMA-{{ activityData.getMovingAveragePeriod() }}',
                    data: [
                        {% for point in activityData.getVelocityAveragePoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: '#e74c3c',
                    backgroundColor: 'rgba(231, 76, 60, 0)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: false,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }
            ]
        };
        
        {% if zoneAnalysis %}
        velocityData.zoneColors = [
            {% set confirmedPaceSessions = zoneAnalysis.getConfirmedPaceZoneSessions() %}
            {% for session in confirmedPaceSessions %}
                {
                    name: '{{ session.zone.value }}',
                    startTime: '{{ session.start.format('H:i:s') }}',
                    endTime: '{{ session.end.format('H:i:s') }}',
                    color: '{{ session.zone.getColor() }}'
                }{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ];
        {% endif %}

        new Chart(velocityCtx, {
            type: 'line',
            data: velocityData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    },
                    zoneBackground: {}
                },
                scales: {
                    y: {
                        {% if metaData.useInverseScale() %}
                        reverse: true,
                        min: {{ metaData.getChartYAxisMinValue() }},
                        max: {{ metaData.getChartYAxisMaxValue() }},
                        {% else %}
                        min: 0,
                        {% endif %}
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: '{{ metaData.getChartYAxisLabel() }}',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}

        {% if activityData.hasHeartRateData() %}
        const heartRateCtx = document.getElementById('heartRateChart').getContext('2d');
        const heartRateData = {
            labels: [
                {% for point in activityData.getHeartRatePoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [{
                label: 'Heart Rate (bpm)',
                data: [
                    {% for point in activityData.getHeartRatePoints() %}
                        {{ point.value }}{{ not loop.last ? ',' : '' }}
                    {% endfor %}
                ],
                borderColor: '#e74c3c',
                backgroundColor: 'rgba(231, 76, 60, 0.1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointRadius: 0,
                pointHoverRadius: 6
            }]
        };
        
        {% if zoneAnalysis %}
        heartRateData.zoneColors = [
            {% set hrZoneSessions = zoneAnalysis.heartRateZoneSessions %}
            {% for session in hrZoneSessions %}
                {
                    name: '{{ session.zone.value }}',
                    startTime: '{{ session.start.format('H:i:s') }}',
                    endTime: '{{ session.end.format('H:i:s') }}',
                    color: '{{ session.zone.getColor() }}'
                }{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ];
        {% endif %}

        new Chart(heartRateCtx, {
            type: 'line',
            data: heartRateData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    },
                    zoneBackground: {}
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Heart Rate (bpm)',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}
    </script>
</body>
</html>
