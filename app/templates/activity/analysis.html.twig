{% extends "base.html.twig" %}

{% block title %}Momentum - Activity - Analysis{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block head_scripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<div class="flex-grow space-y-4 p-4">
    <!-- Activity Header with Share Button -->
    <div class="flex items-start justify-between">
        <div>
            <h2 class="text-2xl font-bold mb-1">{{ meta_data.getActivityName() }}</h2>
            <div class="text-sm text-gray-600">{{ meta_data.getStartDateLocalTime()|format_local_date_time }}</div>
        </div>
        <button
            id="shareButton"
            onclick="openShareModal({{ activity_id }})"
            class="px-4 py-2 bg-sky-500 text-white rounded-lg hover:bg-sky-600 transition-colors flex items-center gap-2 text-sm font-medium"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
            {{ 'activity.share'|trans }}
        </button>
    </div>

    <!-- Share Modal -->
    <div id="shareModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-lg max-w-md w-full">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold">{{ 'activity.share_activity'|trans }}</h3>
                    <button onclick="closeShareModal()" class="text-gray-500 hover:text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="space-y-4">
                    <div id="expiresInSelection">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            {{ 'activity.link_expires_in'|trans }}
                        </label>
                        <select id="expiryDays" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
                            <option value="7">{{ 'activity.days_7'|trans }}</option>
                            <option value="30" selected>{{ 'activity.days_30'|trans }}</option>
                            <option value="60">{{ 'activity.days_60'|trans }}</option>
                            <option value="365">{{ 'activity.days_1_year'|trans }}</option>
                        </select>
                    </div>

                    <div id="shareContent" class="hidden space-y-3">
                        <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
                            <p class="text-xs text-gray-600 mb-2">{{ 'activity.share_link'|trans }}</p>
                            <div class="flex items-center gap-2">
                                <input
                                    id="shareLink"
                                    type="text"
                                    readonly
                                    class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded text-sm font-mono"
                                />
                                <button
                                    onclick="copyToClipboard()"
                                    class="px-3 py-2 bg-sky-500 text-white rounded hover:bg-sky-600 transition-colors text-sm font-medium"
                                >
                                    {{ 'activity.copy'|trans }}
                                </button>
                            </div>
                        </div>

                        <div class="p-3 bg-gray-50 rounded-lg">
                            <p class="text-xs text-gray-600 mb-1">{{ 'activity.expires'|trans }}</p>
                            <p id="expiryDate" class="text-sm font-medium text-gray-900"></p>
                        </div>
                    </div>

                    <div id="loadingState" class="flex items-center justify-center py-4 gap-2">
                        <span class="text-gray-600">{{ 'activity.generating_link'|trans }}</span>
                    </div>

                    <button
                        id="generateButton"
                        onclick="generateShareLink()"
                        class="w-full px-4 py-2 bg-sky-500 text-white rounded-lg hover:bg-sky-600 transition-colors font-medium"
                    >
                        {{ 'activity.generate_link'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats -->
    {% include 'activity/_stats.html.twig' with { meta_data: meta_data, activity_data: activity_data } %}

    <!-- Training Zones -->
    <div>
        <h2 class="text-2xl font-bold mb-2">{{ 'activity.training_zones'|trans }}</h2>
        <p class="text-sm text-gray-600 mb-4">
            {{ 'activity.zones_description'|trans }}
        </p>

        {% if meta_data.usesPaceZones() and pace_zone_sessions | length > 0 %}
           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; align-items: stretch;">
                {% if meta_data.isRun() %}
                   <div>
                       {% include 'activity/_metrics.html.twig' with { metrics: metrics } %}
                   </div>
               {% endif %}
              <div>
                  {% include 'activity/_heart_rate_zones.html.twig' with { hr_stats: hr_stats } %}
              </div>
              <div>
                  {% include 'activity/_pace_zones.html.twig' with { pace_stats: pace_stats } %}
              </div>
           </div>

        {% elseif not meta_data.usesPaceZones() and heart_rate_zone_sessions | length > 0 %}
           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; align-items: stretch;">
               <div>
                   {% include 'activity/_heart_rate_zones.html.twig' with { hr_stats: hr_stats } %}
               </div>
               {% if meta_data.isRun() %}
                   <div>
                       {% include 'activity/_metrics.html.twig' with { metrics: metrics } %}
                   </div>
               {% endif %}
           </div>

        {% elseif app.user.getTreshold().isZero() %}
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4">
                {{ 'activity.configure_threshold'|trans }}
            </div>
        {% endif %}
    </div>
    
    <!-- Charts -->
    {% if not activity_data.hasAnyData() %}
        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4">
            {{ 'activity.no_data_available'|trans }}
        </div>
    {% else %}
        {% if activity_data.hasVelocityData() %}
            <div>
                <h3 class="text-2xl font-bold mb-3">{{ meta_data.getVelocityChartTitle() }}</h3>
                <div class="h-80 bg-white border-gray-200 rounded border p-4">
                    <canvas id="velocityChart"></canvas>
                </div>
            </div>
        {% endif %}

        {% if activity_data.hasHeartRateData() %}
            <div>
                <h3 class="text-2xl font-bold mb-3">{{ 'activity.heart_rate_over_time'|trans }}</h3>
                <div class="h-80 bg-white border-gray-200 rounded border p-4">
                    <canvas id="heartRateChart"></canvas>
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>

<script>
    const zoneBackgroundPlugin = {
        id: 'zoneBackground',
        afterDatasetsDraw(chart) {
            if (!chart.data.zoneColors || chart.data.zoneColors.length === 0) return;

            const ctx = chart.ctx;
            const xScale = chart.scales.x;
            const yScale = chart.scales.y;
            const chartArea = chart.chartArea;
            const labels = chart.data.labels;

            chart.data.zoneColors.forEach(zone => {
                const startIdx = labels.findIndex(label => label >= zone.startTime);
                const endIdx = labels.findIndex(label => label > zone.endTime);
                
                if (startIdx === -1) return;
                
                const startPixel = startIdx < labels.length 
                    ? xScale.getPixelForValue(startIdx)
                    : chartArea.left;
                const endPixel = endIdx === -1 
                    ? chartArea.right
                    : xScale.getPixelForValue(endIdx);

                ctx.save();
                ctx.fillStyle = zone.color + '44';
                ctx.fillRect(
                    Math.max(startPixel, chartArea.left),
                    chartArea.top,
                    Math.min(endPixel, chartArea.right) - Math.max(startPixel, chartArea.left),
                    chartArea.bottom - chartArea.top
                );

                if (endPixel - startPixel > 40) {
                    ctx.fillStyle = zone.color;
                    ctx.font = '11px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(
                        zone.name,
                        (Math.max(startPixel, chartArea.left) + Math.min(endPixel, chartArea.right)) / 2,
                        chartArea.top + 15
                    );
                }
                ctx.restore();
            });
        }
    };
    
    Chart.register(zoneBackgroundPlugin);
    
    {% if activity_data.hasVelocityData() %}
    const velocityCtx = document.getElementById('velocityChart').getContext('2d');
    const velocityData = {
        labels: [
            {% for point in activity_data.getVelocityRawPoints() %}
                '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ],
        datasets: [
            {
                label: '{{ meta_data.getVelocityLabel() }}',
                data: [
                    {% for point in activity_data.getVelocityRawPoints() %}
                        {{ point.value }}{{ not loop.last ? ',' : '' }}
                    {% endfor %}
                ],
                borderColor: 'rgba(102, 126, 234, 0.5)',
                backgroundColor: 'rgba(102, 126, 234, 0.08)',
                borderWidth: 1.5,
                tension: 0.4,
                fill: true,
                pointRadius: 0,
                pointHoverRadius: 6
            },
            {
                label: 'EMA-{{ activity_data.getMovingAveragePeriod() }}',
                data: [
                    {% for point in activity_data.getVelocityAveragePoints() %}
                        {{ point.value }}{{ not loop.last ? ',' : '' }}
                    {% endfor %}
                ],
                borderColor: '#e74c3c',
                backgroundColor: 'rgba(231, 76, 60, 0)',
                borderWidth: 2,
                tension: 0.4,
                fill: false,
                pointRadius: 0,
                pointHoverRadius: 6
            }
        ]
    };
    
    {% if meta_data.usesPaceZones() and pace_zone_sessions | length > 0 %}
        velocityData.zoneColors = [
            {% for session in pace_zone_sessions %}
                {
                    name: '{{ session.zone | zone_label }}',
                    startTime: '{{ session.start.format('H:i:s') }}',
                    endTime: '{{ session.end.format('H:i:s') }}',
                    color: '{{ session.zone.value | zone_color('pace') }}'
                }{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ];
    {% endif %}

    new Chart(velocityCtx, {
        type: 'line',
        data: velocityData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: { padding: 15, font: { size: 13, weight: 600 } }
                },
                zoneBackground: {}
            },
            scales: {
                y: {
                    {% if meta_data.hasSpeed() %}
                        min: 0,
                    {% else %}
                        reverse: true,
                        min: {{ activity_data | y_axis_min }},
                        max: {{ activity_data | y_axis_max }},
                    {% endif %}
                    ticks: { font: { size: 12 } },
                    title: {
                        display: true,
                        text: '{{ activity_data | y_axis_label }}',
                        font: { size: 13, weight: 600 }
                    }
                },
                x: {
                    ticks: { font: { size: 12 } },
                    title: {
                        display: true,
                        text: '{{ activity_data | x_axis_label }}',
                        font: { size: 13, weight: 600 }
                    }
                }
            }
        }
    });
    {% endif %}

    {% if activity_data.hasHeartRateData() %}
    const heartRateCtx = document.getElementById('heartRateChart').getContext('2d');
    const heartRateData = {
        labels: [
            {% for point in activity_data.getHeartRatePoints() %}
                '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ],
        datasets: [{
            label: '{{ activity_data | y_axis_hf_label }}',
            data: [
                {% for point in activity_data.getHeartRatePoints() %}
                    {{ point.value }}{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            borderColor: '#e74c3c',
            backgroundColor: 'rgba(231, 76, 60, 0.1)',
            borderWidth: 2,
            tension: 0.4,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 6
        }]
    };
    
    {% if heart_rate_zone_sessions | length > 0 %}
        heartRateData.zoneColors = [
            {% for session in heart_rate_zone_sessions %}
                {
                    name: '{{ session.zone | zone_label }}',
                    startTime: '{{ session.start.format('H:i:s') }}',
                    endTime: '{{ session.end.format('H:i:s') }}',
                    color: '{{ session.zone.value | zone_color('hf') }}'
                }{{ not loop.last ? ',' : '' }}
            {% endfor %}
        ];
    {% endif %}

    new Chart(heartRateCtx, {
        type: 'line',
        data: heartRateData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: { padding: 15, font: { size: 13, weight: 600 } }
                },
                zoneBackground: {}
            },
            scales: {
                y: {
                    beginAtZero: false,
                    ticks: { font: { size: 12 } },
                    title: {
                        display: true,
                        text: '{{ activity_data | y_axis_hf_label }}',
                        font: { size: 13, weight: 600 }
                    }
                },
                x: {
                    ticks: { font: { size: 12 } },
                    title: {
                        display: true,
                        text: '{{ activity_data | x_axis_label }}',
                        font: { size: 13, weight: 600 }
                    }
                }
            }
        }
    });
    {% endif %}

    // Share modal functions
    function openShareModal(activityId) {
        document.getElementById('shareModal').classList.remove('hidden');
        document.getElementById('shareLink').value = '';
        document.getElementById('expiryDate').textContent = '';
        document.getElementById('shareContent').classList.add('hidden');
        document.getElementById('loadingState').classList.add('hidden');
        document.getElementById('generateButton').classList.remove('hidden');
    }

    function closeShareModal() {
        document.getElementById('shareModal').classList.add('hidden');
    }

    function generateShareLink() {
        const activityId = {{ activity_id }};
        const expiryDays = document.getElementById('expiryDays').value;
        const generateButton = document.getElementById('generateButton');

        generateButton.classList.add('hidden');
        document.getElementById('loadingState').classList.remove('hidden');

        fetch(`/activity/${activityId}/share`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ expires_in: parseInt(expiryDays) })
        })
        .then(response => {
            if (!response.ok) throw new Error('Failed to generate share link');
            return response.json();
        })
        .then(data => {
            document.getElementById('shareLink').value = data.share_url;
            document.getElementById('expiryDate').textContent = new Date(data.expires_at).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('shareContent').classList.remove('hidden');
            document.getElementById('expiresInSelection').classList.add('hidden');
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to generate share link');
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('generateButton').classList.remove('hidden');
        });
    }

    function copyToClipboard() {
        const shareLink = document.getElementById('shareLink');
        shareLink.select();
        document.execCommand('copy');

        const copyButton = event.target;
        const originalText = copyButton.textContent;
        copyButton.textContent = '{{ 'activity.copied'|trans }}';
        setTimeout(() => {
            copyButton.textContent = originalText;
        }, 2000);
    }

    // Close modal when clicking outside
    document.getElementById('shareModal').addEventListener('click', function(event) {
        if (event.target === this) {
            closeShareModal();
        }
    });
</script>

{% include 'components/_footer.html.twig' %}
{% endblock %}
