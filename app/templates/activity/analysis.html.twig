<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Activity Analysis - Momentum</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
            padding-top: 0;
        }

        .container-custom {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .activity-header {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.7) 0%, rgba(118, 75, 162, 0.7) 100%);
            color: white;
            padding: 1.5rem 2rem;
            border-radius: 12px;
            margin-top: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.12);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .activity-header-content {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            align-items: stretch;
        }

        .activity-left-column {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .activity-right-column {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .activity-title {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0;
        }

        .activity-title-content {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .activity-emoji {
            font-size: 2rem;
            flex-shrink: 0;
            margin-top: 0.15rem;
        }

        .activity-name {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            line-height: 1.2;
        }

        .activity-datetime {
            font-size: 0.9rem;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .activity-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .stats-panel {
            background: rgba(255, 255, 255, 0.06);
            padding: 0.75rem;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.4rem 0;
            flex: 1;
            align-self: stretch;
        }

        .stat-row-separator {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.08);
            padding: 0.9rem;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            transition: all 0.3s ease;
        }

        .stat-box:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.18);
            transform: translateY(-2px);
        }

        .stat-label {
            font-size: 0.7rem;
            opacity: 0.7;
            margin-bottom: 0.3rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .stat-value {
            font-size: 1.3rem;
            font-weight: 600;
            line-height: 1;
        }

        .stat-row-label {
            font-size: 0.75rem;
            opacity: 0.75;
        }

        .stat-row-value {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .chart-container {
            background: white;
            border-radius: 16px;
            padding: 2.5rem;
            margin-bottom: 3rem;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .chart-container:hover {
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        }

        .chart-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: #333;
        }

        .chart-wrapper {
            position: relative;
            height: 450px;
            margin-bottom: 1rem;
        }

        .alert-message {
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 1rem;
            font-weight: 500;
        }

        .alert-info {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            color: #1565c0;
            border-left: 4px solid #667eea;
        }

        @media (max-width: 768px) {
            .activity-header {
                padding: 1.5rem;
            }

            .activity-header-content {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .activity-name {
                font-size: 1.5rem;
            }

            .activity-emoji {
                font-size: 1.5rem;
            }

            .activity-stats {
                grid-template-columns: 1fr 1fr;
            }

            .chart-wrapper {
                height: 300px;
            }

            .container-custom {
                padding: 0 1rem;
            }
        }
    </style>
</head>
<body>
    {% include 'components/_header.html.twig' %}

    <div class="container-custom">
        <div class="activity-header">
            <div class="activity-header-content">
                <div class="activity-left-column">
                    <div class="activity-title">
                        <span class="activity-emoji">{{ metaData.getEmoji() }}</span>
                        <div class="activity-title-content">
                            <h1 class="activity-name">{{ metaData.getActivityName() }}</h1>
                            <div class="activity-datetime">
                                <span>{{ metaData.getStartDateLocalTimeFormatted() }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="activity-stats">
                        <div class="stat-box">
                            <div class="stat-label">Distance</div>
                            <div class="stat-value">
                                {% if metaData.getData()['distance'] is not null %}
                                    {{ (metaData.getData()['distance'].getMeters() / 1000) | number_format(1, '.') }} km
                                {% else %}
                                    <span style="opacity: 0.5;">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-label">Duration</div>
                            <div class="stat-value">{{ metaData.getMovingTimeAsString() }}</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-label">Avg. {{ metaData.getLabel() }}</div>
                            <div class="stat-value">
                                {% if metaData.getData()['average_velocity'] is not null %}
                                    {{ metaData.getData()['average_velocity'] }}
                                {% else %}
                                    <span style="opacity: 0.5;">N/A</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="activity-right-column">
                    <div class="stats-panel">
                        {% if activityData.hasHeartRateData() %}
                        <div class="stat-row stat-row-separator">
                            <span class="stat-row-label">Avg. Heart Rate</span>
                            <span class="stat-row-value">{{ activityData.getHeartRateAverage() }} bpm</span>
                        </div>
                        {% endif %}

                        {% if activityData.hasHeartRateData() %}
                        <div class="stat-row stat-row-separator">
                            <span class="stat-row-label">Max. Heart Rate</span>
                            <span class="stat-row-value">{{ activityData.getHeartRateMax() }} bpm</span>
                        </div>
                        {% endif %}

                        {% if activityData.hasVelocityData() %}
                        <div class="stat-row">
                            <span class="stat-row-label">Max. {{ metaData.getLabel() }}</span>
                            <span class="stat-row-value">{{ activityData.getVelocityMax() | format_velocity(metaData.getActivityType()) }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if not activityData.hasAnyData() %}
            <div class="alert-message alert-info">
                <span>⚠️</span>
                <span>No data available for analysis. This activity may not have complete stream data.</span>
            </div>
        {% else %}
            {% if activityData.hasVelocityData() %}
                <div class="chart-container">
                    <div class="chart-title">{{ metaData.getChartTitle() }}</div>
                    <div class="chart-wrapper">
                        <canvas id="velocityChart"></canvas>
                    </div>
                </div>
            {% else %}
                <div class="alert-message alert-info">
                    <span>ℹ️</span>
                    <span>Velocity data not available for this activity.</span>
                </div>
            {% endif %}

            {% if activityData.hasHeartRateData() %}
                <div class="chart-container">
                    <div class="chart-title">❤️ Heart Rate Over Time</div>
                    <div class="chart-wrapper">
                        <canvas id="heartRateChart"></canvas>
                    </div>
                </div>
            {% else %}
                <div class="alert-message alert-info">
                    <span>ℹ️</span>
                    <span>Heart rate data not available for this activity.</span>
                </div>
            {% endif %}
        {% endif %}

        {% if zoneAnalysis %}
            {% set paceStats = zoneAnalysis.getPaceZoneStatistics() %}
            {% set hrStats = zoneAnalysis.getHeartRateZoneStatistics() %}
            {% set polarized = zoneAnalysis.getPolarizedTrainingMetrics() %}
            <div class="chart-container">
                <div class="chart-title">🎯 Training Zones & Polarized Training</div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
                    <!-- Pace Zones -->
                    <div>
                        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #333;">Pace Zones</h3>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            {% for zoneKey, stat in paceStats.zoneStats %}
                                {% set zone = stat.zone %}
                                {% set percentage = stat.duration_percentage %}
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div style="font-size: 0.9rem; font-weight: 600; color: #666; min-width: 60px;">
                                        {{ zone.getName() }}
                                    </div>
                                    <div style="flex: 1; background: #e0e0e0; border-radius: 4px; height: 24px; overflow: hidden; position: relative;">
                                        <div style="
                                            height: 100%;
                                            width: {{ percentage }}%;
                                            background: {{ zone.getColor() }};
                                            border-radius: 4px;
                                            transition: width 0.3s ease;
                                        "></div>
                                    </div>
                                    <div style="font-size: 0.85rem; color: #999; min-width: 50px; text-align: right;">
                                        {{ percentage | number_format(1, '.') }}%
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Heart Rate Zones -->
                    {% if hrStats %}
                    <div>
                        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #333;">❤️ Heart Rate Zones</h3>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            {% for zoneKey, stat in hrStats.zoneStats %}
                                {% set zone = stat.zone %}
                                {% set percentage = stat.duration_percentage %}
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div style="font-size: 0.9rem; font-weight: 600; color: #666; min-width: 60px;">
                                        {{ zone.getName() }}
                                    </div>
                                    <div style="flex: 1; background: #e0e0e0; border-radius: 4px; height: 24px; overflow: hidden; position: relative;">
                                        <div style="
                                            height: 100%;
                                            width: {{ percentage }}%;
                                            background: {{ zone.getColor() }};
                                            border-radius: 4px;
                                            transition: width 0.3s ease;
                                        "></div>
                                    </div>
                                    <div style="font-size: 0.85rem; color: #999; min-width: 50px; text-align: right;">
                                        {{ percentage | number_format(1, '.') }}%
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>

                <!-- Polarized Training Feedback -->
                <div style="
                    background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
                    padding: 1.5rem;
                    border-radius: 10px;
                    border-left: 4px solid {% if polarized.isPolarized() %}#4caf50{% else %}#ff9800{% endif %};
                    margin-bottom: 1rem;
                ">
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
                        <div style="text-align: center;">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Easy (Zones 1-2)</div>
                            <div style="font-size: 1.8rem; font-weight: 700; color: #2196f3;">
                                {{ polarized.getEasyPercentage() | number_format(1, '.') }}%
                            </div>
                        </div>
                        <div style="text-align: center;">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Tempo (Zone 3)</div>
                            <div style="font-size: 1.8rem; font-weight: 700; color: #ff9800;">
                                {{ polarized.getTempoPercentage() | number_format(1, '.') }}%
                            </div>
                        </div>
                        <div style="text-align: center;">
                            <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">Hard (Zones 4-5)</div>
                            <div style="font-size: 1.8rem; font-weight: 700; color: #f44336;">
                                {{ polarized.getHardPercentage() | number_format(1, '.') }}%
                            </div>
                        </div>
                    </div>
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0; text-align: center;">
                        {% if polarized.isPolarized() %}
                            <div style="color: #4caf50; font-weight: 600;">✓ Following polarized training principles (80% easy + 15% hard)</div>
                        {% else %}
                            <div style="color: #ff9800; font-weight: 600;">⚠ Not following polarized training pattern yet</div>
                        {% endif %}
                    </div>
                </div>

                <!-- Cross-Validation Note -->
                <div style="
                    background: #e8f5e9;
                    padding: 1rem;
                    border-radius: 6px;
                    border-left: 3px solid #4caf50;
                    margin-bottom: 1rem;
                    font-size: 0.9rem;
                    color: #2e7d32;
                ">
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">ℹ️ Zone Validation</div>
                    <div>Hard zones (Threshold, VO2max) are validated by heart rate data to eliminate false positives from brief pace spikes. Only confirmed zones are used for polarized training calculations.</div>
                </div>

                <!-- Zone Transitions Timeline -->
                {% if paceStats.getZoneSessions() | length > 0 %}
                <div>
                    <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #333;">Pace Zone Transitions</h3>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 400px; overflow-y: auto;">
                        {% for session in paceStats.getZoneSessions() %}
                            <div style="
                                display: flex;
                                align-items: center;
                                gap: 0.75rem;
                                padding: 0.75rem;
                                background: {{ session.zone.getColor() }}22;
                                border-left: 3px solid {{ session.zone.getColor() }};
                                border-radius: 4px;
                                font-size: 0.9rem;
                            ">
                                <div style="font-weight: 600; color: {{ session.zone.getColor() }};">{{ session.zone.getName() }}</div>
                                <div style="color: #666;">{{ session.startTime | date('H:i:s') }}</div>
                                <div style="color: #999;">→ {{ '%02d:%02d' | format((session.durationSeconds // 60), (session.durationSeconds % 60)) }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        {% elseif app.user.getFtpMinutesPerKilometer() is null %}
            <div class="alert-message alert-info" style="background: linear-gradient(135deg, #fff3cd 0%, #fff8e1 100%); color: #856404; border-left-color: #ffc107;">
                <span>⚙️</span>
                <span>To see zone analysis, please configure your FTP in your profile settings.</span>
            </div>
        {% endif %}
    </div>

    <script>
        {% if activityData.hasVelocityData() %}
        const velocityCtx = document.getElementById('velocityChart').getContext('2d');
        const velocityData = {
            labels: [
                {% for point in activityData.getVelocityRawPoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [
                {
                    label: 'Velocity',
                    data: [
                        {% for point in activityData.getVelocityRawPoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: 'rgba(102, 126, 234, 0.5)',
                    backgroundColor: 'rgba(102, 126, 234, 0.08)',
                    borderWidth: 1.5,
                    tension: 0.4,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 6
                },
                {
                    label: 'EMA-{{ activityData.getMovingAveragePeriod() }}',
                    data: [
                        {% for point in activityData.getVelocityAveragePoints() %}
                            {{ point.value }}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ],
                    borderColor: '#e74c3c',
                    backgroundColor: 'rgba(231, 76, 60, 0)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: false,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }
            ]
        };

        new Chart(velocityCtx, {
            type: 'line',
            data: velocityData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    }
                },
                scales: {
                    y: {
                        {% if metaData.useInverseScale() %}
                        reverse: true,
                        min: {{ metaData.getChartYAxisMinValue() }},
                        max: {{ metaData.getChartYAxisMaxValue() }},
                        {% else %}
                        min: 0,
                        {% endif %}
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: '{{ metaData.getChartYAxisLabel() }}',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}

        {% if activityData.hasHeartRateData() %}
        const heartRateCtx = document.getElementById('heartRateChart').getContext('2d');
        const heartRateData = {
            labels: [
                {% for point in activityData.getHeartRatePoints() %}
                    '{{ point.timestamp }}'{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ],
            datasets: [{
                label: 'Heart Rate (bpm)',
                data: [
                    {% for point in activityData.getHeartRatePoints() %}
                        {{ point.value }}{{ not loop.last ? ',' : '' }}
                    {% endfor %}
                ],
                borderColor: '#e74c3c',
                backgroundColor: 'rgba(231, 76, 60, 0.1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointRadius: 0,
                pointHoverRadius: 6
            }]
        };

        new Chart(heartRateCtx, {
            type: 'line',
            data: heartRateData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13, weight: 600 }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Heart Rate (bpm)',
                            font: { size: 13, weight: 600 }
                        }
                    },
                    x: {
                        ticks: { font: { size: 12 } },
                        title: {
                            display: true,
                            text: 'Time (HH:MM:SS)',
                            font: { size: 13, weight: 600 }
                        }
                    }
                }
            }
        });
        {% endif %}
    </script>
</body>
</html>
