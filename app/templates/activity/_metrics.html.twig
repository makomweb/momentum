<div class="bg-white border border-gray-200 rounded p-4 flex flex-col h-full overflow-hidden" style="max-height: 15rem;">
    <div class="flex gap-2 items-center mb-3 flex-shrink-0">
        <span class="px-2 py-1 rounded text-xs font-semibold text-white {{ metrics | get_metrics_description_background_color }}">
            {{ metrics | get_metrics_description }}
        </span>
    </div>
    <div class="space-y-2 overflow-y-auto flex-grow">
        <div>
            <div class="flex justify-between items-start mb-1">
                <div class="text-xs font-semibold">Z1-2 (easy)</div>
                <div class="text-xs font-bold text-blue-600">{{ metrics.getEasyPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-blue-500 h-full rounded" style="width: {{ min(metrics.getEasyPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
        <div>
            <div class="flex justify-between items-start mb-1">
                <div class="text-xs font-semibold">Z3 (medium)</div>
                <div class="text-xs font-bold text-amber-600">{{ metrics.getMediumPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-amber-500 h-full rounded" style="width: {{ min(metrics.getMediumPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
        <div>
            <div class="flex justify-between items-start mb-1">
                <div class="text-xs font-semibold">Z4-5 (hard)</div>
                <div class="text-xs font-bold text-red-600">{{ metrics.getHardPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-red-500 h-full rounded" style="width: {{ min(metrics.getHardPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
    </div>
</div>
