<div class="zone-summary-card {% if metrics.isBalanced() %}zone-summary-card--balanced{% else %}zone-summary-card--unbalanced{% endif %}">
    <div class="zone-summary-header">
        <span class="zone-summary-badge">
            {% if metrics.isBalanced() %}✅ Balanced{% else %}⚠️ Unbalanced{% endif %}
        </span>
        <span class="zone-summary-hint">
            {% if metrics.isBalanced() %}
                Good balance of easy aerobic base and hard quality work.
            {% else %}
                Shift more volume into easy (Z1–2) or hard (Z4–5) zones.
            {% endif %}
        </span>
    </div>
    <div class="zone-summary-body">
        <div class="zone-summary-grid">
            <div class="zone-summary-metric-inner">
                <div class="zone-summary-label">Easy · Z1–2</div>
                <div class="zone-summary-value" style="color: #2196f3;">{{ metrics.getEasyPercentage() | number_format(1, '.') }}%</div>
                <div class="zone-summary-bar">
                    <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getEasyPercentage(), 100) | number_format(1, '.') }}%; background: #2196f3;"></div>
                </div>
            </div>
            <div class="zone-summary-metric-inner">
                <div class="zone-summary-label">Medium · Z3</div>
                <div class="zone-summary-value" style="color: #ff9800;">{{ metrics.getMediumPercentage() | number_format(1, '.') }}%</div>
                <div class="zone-summary-bar">
                    <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getMediumPercentage(), 100) | number_format(1, '.') }}%; background: #ff9800;"></div>
                </div>
            </div>
            <div class="zone-summary-metric-inner">
                <div class="zone-summary-label">Hard · Z4–5</div>
                <div class="zone-summary-value" style="color: #f44336;">{{ metrics.getHardPercentage() | number_format(1, '.') }}%</div>
                <div class="zone-summary-bar">
                    <div class="zone-summary-bar-fill" style="width: {{ min(metrics.getHardPercentage(), 100) | number_format(1, '.') }}%; background: #f44336;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
