<div class="{% if metrics.isBalanced() %}bg-green-50 border-l-4 border-green-500{% else %}bg-yellow-50 border-l-4 border-yellow-500{% endif %} p-4">
    <div class="flex gap-2 items-center mb-3">
        <span class="px-2 py-1 rounded text-xs font-semibold text-white {% if metrics.isBalanced() %}bg-green-600{% else %}bg-yellow-600{% endif %}">
            {% if metrics.isBalanced() %}Balanced{% else %}Unbalanced{% endif %}
        </span>
        <small class="text-xs {% if metrics.isBalanced() %}text-green-700{% else %}text-yellow-700{% endif %}">
            {% if metrics.isBalanced() %}
                Good balance of easy and hard work.
            {% else %}
                Shift more volume into easy (Z1–2) or hard (Z4–5) zones.
            {% endif %}
        </small>
    </div>
    <div class="space-y-2">
        <div>
            <div class="flex justify-between items-start mb-1 text-xs">
                <div class="font-semibold">Easy · Z1–2</div>
                <div class="font-bold text-blue-600">{{ metrics.getEasyPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-blue-500 h-full rounded" style="width: {{ min(metrics.getEasyPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
        <div>
            <div class="flex justify-between items-start mb-1 text-xs">
                <div class="font-semibold">Medium · Z3</div>
                <div class="font-bold text-amber-600">{{ metrics.getMediumPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-amber-500 h-full rounded" style="width: {{ min(metrics.getMediumPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
        <div>
            <div class="flex justify-between items-start mb-1 text-xs">
                <div class="font-semibold">Hard · Z4–5</div>
                <div class="font-bold text-red-600">{{ metrics.getHardPercentage() | number_format(1, '.') }}%</div>
            </div>
            <div class="w-full bg-gray-200 rounded h-1.5">
                <div class="bg-red-500 h-full rounded" style="width: {{ min(metrics.getHardPercentage(), 100) | number_format(1, '.') }}%;"></div>
            </div>
        </div>
    </div>
</div>
