<a href="{{ path('activity_analysis_by_id', { id: activity.stravaActivityId }) }}" class="block no-underline">
    <div class="bg-white rounded border p-4" data-activity-card data-activity-type="{{ activity.data.type | lower }}">
        <div class="flex flex-col h-full">
            <div class="flex items-start gap-2 mb-3">
                <span class="text-2xl flex-shrink-0">
                    {% set type_lower = activity.data.type | lower %}
                    {% if type_lower == 'run' %}
                        🏃
                    {% elseif type_lower == 'ride' %}
                        🚴
                    {% elseif type_lower == 'swim' %}
                        🏊
                    {% elseif type_lower == 'walk' %}
                        🚶
                    {% elseif type_lower == 'hike' %}
                        🥾
                    {% else %}
                        🏅
                    {% endif %}
                </span>
                <div class="flex-grow min-w-0">
                    <h3 class="font-semibold truncate mb-0.5">{{ activity.data.name }}</h3>
                    <small class="text-gray-500 block text-xs">{{ activity.getStartDateFormatted() }}</small>
                </div>
            </div>

            <div class="mt-auto space-y-2 text-xs">
                {%- set type_lower = activity.data.type | lower -%}
                
                {%- if activity.data.distance > 0 -%}
                <div class="flex justify-between">
                    <span class="text-gray-600">Distance</span>
                    <span class="font-semibold">{{ (activity.data.distance / 1000) | round(1) }} km</span>
                </div>
                {%- endif -%}
                <div class="flex justify-between">
                    <span class="text-gray-600">Moving Time</span>
                    <span class="font-semibold">{{ activity.getMovingTime() | format_moving_time }}</span>
                </div>
                {%- if activity.data.distance > 0 -%}
                <div class="flex justify-between">
                    <span class="text-gray-600">
                        {%- if type_lower == 'ride' -%}
                            Speed
                        {%- else -%}
                            Pace
                        {%- endif -%}
                    </span>
                    <span class="font-semibold">{{ activity.getAverageVelocityAsStringable() }}</span>
                </div>
                {%- endif -%}
            </div>

            <div class="mt-3 pt-2 text-blue-600 text-xs font-semibold flex items-center gap-1 opacity-70 hover:opacity-100">
                View details <span>→</span>
            </div>
        </div>
    </div>
</a>
