<a href="{{ path('activity_analysis_by_id', { id: activity.stravaActivityId }) }}" class="block no-underline">
    <div class="bg-white rounded border border-gray-200 p-4 flex flex-col h-full" data-activity-card data-activity-type="{{ activity.data.type | lower }}">
        <div class="flex items-start gap-2 mb-4">
            <span class="text-2xl flex-shrink-0">
                {% set type_lower = activity.data.type | lower %}
                {% if type_lower == 'run' %}
                    🏃
                {% elseif type_lower == 'ride' %}
                    🚴
                {% elseif type_lower == 'swim' %}
                    🏊
                {% elseif type_lower == 'walk' %}
                    🚶
                {% elseif type_lower == 'hike' %}
                    🥾
                {% else %}
                    🏅
                {% endif %}
            </span>
            <div class="flex-grow min-w-0">
                <h3 class="font-semibold truncate mb-0.5">{{ activity.data.name }}</h3>
                <div class="text-gray-600 text-xs">{{ activity.getStartDateFormatted() }}</div>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-2 flex-grow">
            {%- set type_lower = activity.data.type | lower -%}
            
            {%- if activity.data.distance > 0 -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">Distance</div>
                <div class="text-sm font-bold truncate">{{ (activity.data.distance / 1000) | round(1) }} km</div>
            </div>
            {%- else -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">Distance</div>
                <div class="text-sm font-bold text-gray-400 truncate">N/A</div>
            </div>
            {%- endif -%}

            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">Moving Time</div>
                <div class="text-sm font-bold truncate">{{ activity.getMovingTime() | format_moving_time }}</div>
            </div>

            {%- if activity.data.distance > 0 -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">
                    {%- if type_lower == 'ride' -%}
                        Speed
                    {%- else -%}
                        Pace
                    {%- endif -%}
                </div>
                <div class="text-sm font-bold truncate">{{ activity.getAverageVelocityAsStringable() }}</div>
            </div>
            {%- else -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">
                    {%- if type_lower == 'ride' -%}
                        Speed
                    {%- else -%}
                        Pace
                    {%- endif -%}
                </div>
                <div class="text-sm font-bold text-gray-400 truncate">N/A</div>
            </div>
            {%- endif -%}
        </div>

        <div class="mt-4 pt-2 text-blue-600 text-xs font-semibold flex items-center gap-1 opacity-70 hover:opacity-100">
            View details <span>→</span>
        </div>
    </div>
</a>
