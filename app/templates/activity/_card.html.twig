{# Activity card for display in activity stream #}
<a href="{{ path('activity_analysis_by_id', { id: activity.stravaActivityId }) }}" class="block no-underline">
    <div class="bg-white rounded-lg shadow hover:shadow-md transition h-full p-6" data-activity-card data-activity-type="{{ activity.data.type | lower }}">
        <div class="flex flex-col h-full">
            <div class="flex items-start gap-3 mb-4">
                <span class="text-3xl flex-shrink-0">
                    {% set type_lower = activity.data.type | lower %}
                    {% if type_lower == 'run' %}
                        🏃
                    {% elseif type_lower == 'ride' %}
                        🚴
                    {% elseif type_lower == 'swim' %}
                        🏊
                    {% elseif type_lower == 'walk' %}
                        🚶
                    {% elseif type_lower == 'hike' %}
                        🥾
                    {% else %}
                        🏅
                    {% endif %}
                </span>
                <div class="flex-grow min-w-0">
                    <h3 class="font-semibold text-gray-900 truncate mb-1">{{ activity.data.name }}</h3>
                    <small class="text-gray-600 block">{{ activity.getStartDateFormatted() }}</small>
                </div>
            </div>

            <div class="mt-auto">
                {%- set type_lower = activity.data.type | lower -%}
                
                {# Display stats in 2-3 columns #}
                <div class="grid gap-3 text-center text-sm">
                    {%- if activity.data.distance > 0 -%}
                    <div>
                        <div class="text-gray-600 uppercase text-xs font-semibold tracking-wide">Distance</div>
                        <div class="font-bold text-gray-900">{{ (activity.data.distance / 1000) | round(1) }} km</div>
                    </div>
                    {%- endif -%}
                    <div>
                        <div class="text-gray-600 uppercase text-xs font-semibold tracking-wide">Moving Time</div>
                        <div class="font-bold text-gray-900">{{ activity.getMovingTime() | format_moving_time }}</div>
                    </div>
                    {%- if activity.data.distance > 0 -%}
                    <div>
                        <div class="text-gray-600 uppercase text-xs font-semibold tracking-wide">
                            {%- if type_lower == 'ride' -%}
                                Speed
                            {%- else -%}
                                Pace
                            {%- endif -%}
                        </div>
                        <div class="font-bold text-gray-900">{{ activity.getAverageVelocityAsStringable() }}</div>
                    </div>
                    {%- endif -%}
                </div>
            </div>

            <div class="mt-4 pt-2 text-indigo-600 text-sm font-semibold flex items-center gap-1 opacity-70">
                View details <span class="text-xs">→</span>
            </div>
        </div>
    </div>
</a>
