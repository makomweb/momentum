{# Activity card for display in activity stream #}
<a href="{{ path('activity_analysis_by_id', { id: activity.stravaActivityId }) }}" class="activity-link">
    <div class="activity-card">
        <div class="activity-header">
            <span class="activity-type-icon">
                {% set type_lower = activity.data.type | lower %}
                {% if type_lower == 'run' %}
                    🏃
                {% elseif type_lower == 'ride' %}
                    🚴
                {% elseif type_lower == 'swim' %}
                    🏊
                {% elseif type_lower == 'walk' %}
                    🚶
                {% elseif type_lower == 'hike' %}
                    🥾
                {% else %}
                    🏅
                {% endif %}
            </span>
            <div class="activity-info-basic">
                <h3 class="activity-name">{{ activity.data.name }}</h3>
                <p class="activity-date">{{ activity.startDate | date('M d, Y | H:i') }}</p>
            </div>
        </div>

        <div class="activity-stats">
            <div class="stat">
                <span class="stat-label">Distance</span>
                <span class="stat-value">{{ (activity.data.distance / 1000) | round(1) }} km</span>
            </div>
            <div class="stat">
                <span class="stat-label">Duration</span>
                <span class="stat-value">{{ (activity.data.moving_time / 60) | round(0) }} min</span>
            </div>
            <div class="stat">
                {%- set type_lower = activity.data.type | lower -%}
                {%- if type_lower in ['run', 'walk'] -%}
                    {# Pace for running/walking activities (min/km) #}
                    <span class="stat-label">Pace</span>
                    <span class="stat-value">
                        {%- if activity.data.distance > 0 -%}
                            {%- set pace_min_km = (activity.data.moving_time / (activity.data.distance / 1000)) | round(1) -%}
                            {%- set minutes = pace_min_km | round(0) -%}
                            {%- set seconds = ((pace_min_km - minutes) * 60) | round(0) -%}
                            {{ minutes }}:{{ seconds | format("%02d") }} /km
                        {%- else -%}
                            N/A
                        {%- endif -%}
                    </span>
                {%- elseif type_lower == 'ride' -%}
                    {# Speed for cycling activities (km/h) #}
                    <span class="stat-label">Speed</span>
                    <span class="stat-value">
                        {%- set speed_kmh = (activity.data.average_speed * 3.6) | round(1) -%}
                        {{ speed_kmh }} km/h
                    </span>
                {%- else -%}
                    {# Default speed in m/s for other activity types #}
                    <span class="stat-label">Speed</span>
                    <span class="stat-value">
                        {{ (activity.data.average_speed) | round(2) }} m/s
                    </span>
                {%- endif -%}
            </div>
        </div>

        <div class="activity-card-hover-indicator">
            View details →
        </div>
    </div>
</a>
