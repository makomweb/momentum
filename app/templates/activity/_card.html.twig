<a href="{{ path('activity_analyze', { id: activity.stravaActivityId }) }}" class="block no-underline">
    <div class="bg-white rounded border border-gray-200 p-2 flex flex-col h-full" data-activity-card data-activity-type="{{ activity.data.type | lower }}">
        <div class="flex items-start justify-between gap-1 mb-3 rounded p-2 {{ activity.data.type | activity_bg_color }}">
            <div class="flex-grow min-w-0">
                <h3 class="font-semibold truncate mb-0.5">{{ activity.data.name }}</h3>
                <div class="text-gray-600 text-xs">{{ activity.getStartDateLocalTime()|format_local_date_time }}</div>
            </div>
            <span class="text-2xl flex-shrink-0">
                {{ activity | activity_emoji }}
            </span>
        </div>

        <div class="grid grid-cols-3 gap-2 flex-grow">
            {%- set type_lower = activity.data.type | lower -%}
            
            {%- if activity.hasDistance() -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">{{ 'activity.distance'|trans }}</div>
                <div class="text-sm font-bold truncate">{{ activity.getDistance() }}</div>
            </div>
            {%- endif -%}

            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">{{ 'activity.moving_time'|trans }}</div>
                <div class="text-sm font-bold truncate">{{ activity.getMovingTime() | format_moving_time }}</div>
            </div>

            {%- if activity.hasVelocity() -%}
            <div class="flex flex-col gap-1 bg-gray-50 border border-gray-200 rounded p-2">
                <div class="text-xs font-semibold text-gray-600">
                    {%- if type_lower == 'ride' -%}
                        {{ 'activity.speed'|trans }}
                    {%- else -%}
                        {{ 'activity.pace'|trans }}
                    {%- endif -%}
                </div>
                <div class="text-sm font-bold truncate">{{ activity.getAverageVelocityAsStringable() }}</div>
            </div>
            {%- endif -%}
        </div>

        <div class="mt-4 pt-2 text-sky-600 text-xs font-semibold flex items-center gap-1 opacity-70 hover:opacity-100">
            {{ 'activity.view_details'|trans }}
        </div>
    </div>
</a>
