<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Momentum{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo.png') }}" type="image/png">
        
        {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        
        {% block head_scripts %}
        {% endblock %}
        
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body {% block body_class %}class="bg-gray-50 text-gray-900"{% endblock %}>
        {% block body %}{% endblock %}
        
        {% block javascripts %}
            {{ importmap('app') }}
            <script type="module">
                import 'app';
            </script>
        {% endblock %}
    </body>
</html>
