<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ name }} - Running Moment</title>
    <meta name="description" content="{{ name }}">
    <meta property="og:title" content="{{ name }}">
    <meta property="og:description" content="{{ name }}">
    <meta property="og:type" content="website">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            max-width: 700px;
            width: 100%;
        }
        .hero-section {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            padding: 24px 20px;
            border-radius: 16px 16px 0 0;
            color: white;
        }
        @media (min-width: 640px) {
            .hero-section {
                padding: 28px 32px;
            }
        }
        .hero-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
        }
        .hero-left {
            flex: 1;
        }
        .activity-name {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
            color: white;
        }
        @media (min-width: 640px) {
            .activity-name {
                font-size: 18px;
            }
        }
        .activity-date {
            font-size: 13px;
            opacity: 0.85;
            font-weight: 400;
            margin: 4px 0 0 0;
            color: white;
        }
        @media (min-width: 640px) {
            .activity-date {
                font-size: 13px;
            }
        }
        .hero-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            flex-shrink: 0;
            object-fit: cover;
            border: 2px solid white;
        }
        @media (min-width: 640px) {
            .user-avatar {
                width: 40px;
                height: 40px;
            }
        }
        .user-name {
            font-size: 13px;
            font-weight: 500;
            opacity: 0.95;
        }
        @media (min-width: 640px) {
            .user-name {
                font-size: 13px;
            }
        }
        .content-section {
            padding: 20px 20px;
        }
        @media (min-width: 640px) {
            .content-section {
                padding: 28px 32px;
            }
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }
        @media (min-width: 640px) {
            .stats {
                gap: 12px;
                margin-bottom: 28px;
            }
        }
        .stat {
            padding: 14px 12px;
            background: linear-gradient(135deg, #f5f7fa 0%, #f0f4f8 100%);
            border-radius: 12px;
            text-align: center;
            border: 1px solid #e8ecf1;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        @media (min-width: 640px) {
            .stat {
                padding: 16px 14px;
            }
        }
        .stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(102, 126, 234, 0.1);
        }
        .stat-label {
            font-size: 10px;
            color: #8b92a6;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.8px;
            margin-bottom: 4px;
        }
        @media (min-width: 640px) {
            .stat-label {
                font-size: 10px;
                margin-bottom: 6px;
            }
        }
        .stat-value {
            font-size: 16px;
            font-weight: 700;
            color: #2d3748;
            line-height: 1.2;
        }
        @media (min-width: 640px) {
            .stat-value {
                font-size: 18px;
                font-weight: 800;
            }
        }
        .zones-title {
            font-size: 12px;
            font-weight: 700;
            color: #2d3748;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
            margin-top: 16px;
        }
        @media (min-width: 640px) {
            .zones-title {
                font-size: 12px;
                margin-bottom: 12px;
                margin-top: 20px;
            }
        }
        .footer {
            padding: 12px 20px;
            border-top: 1px solid #e8ecf1;
            text-align: center;
            background: #f9fafb;
            border-radius: 0 0 16px 16px;
        }
        @media (min-width: 640px) {
            .footer {
                padding: 16px 32px;
            }
        }
        .footer a {
            font-size: 12px;
            color: #667eea;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .footer a:hover {
            color: #5a67d8;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-content">
                <div class="hero-left">
                    <div class="activity-name">{{ name }}</div>
                    <div class="activity-date">{{ start_date|format_local_date_time }}</div>
                </div>
                <div class="hero-right">
                    <div class="user-info">
                        {% if user.getProfilePictureMedium() %}
                            <img src="{{ user.getProfilePictureMedium() }}" alt="{{ user.name }}" class="user-avatar">
                        {% else %}
                            <div class="user-avatar" style="background: rgba(255, 255, 255, 0.3); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 16px;">
                                {{ user.name | first | upper }}
                            </div>
                        {% endif %}
                        <div class="user-name">{{ user.name }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Section -->
        <div class="content-section">
            <!-- Stats -->
            <div class="stats">
                <div class="stat">
                    <div class="stat-label">Distance</div>
                    <div class="stat-value">{{ "%.1f"|format(distance / 1000) }} km</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Avg. Pace</div>
                    <div class="stat-value">{{ average_velocity }}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Time</div>
                    <div class="stat-value">{{ moving_time | format_moving_time }}</div>
                </div>
            </div>

            <!-- Zones -->
            {% if meta_data.usesPaceZones() %}
                <div class="zones-title">Performance Zones</div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% include 'activity/_heart_rate_zones.html.twig' with { hr_stats: hr_stats } %}
                    {% include 'activity/_pace_zones.html.twig' with { pace_stats: pace_stats } %}
                </div>
            {% elseif not meta_data.usesPaceZones() %}
                <div class="zones-title">Heart Rate Zones</div>
                <div>
                    {% include 'activity/_heart_rate_zones.html.twig' with { hr_stats: hr_stats } %}
                </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="footer">
            <a href="/about">About Momentum</a>
        </div>
    </div>
</body>
</html>
