{% extends "base.html.twig" %}

{% block title %}Profile Settings - Momentum{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<main class="max-w-2xl mx-auto px-4 py-8 flex-grow">
    <section class="bg-white rounded border border-gray-200 max-w-2xl w-full">
        <div class="border-b border-gray-200 p-4">
            <h1 class="text-2xl font-bold mb-1">Profile settings</h1>
            <p class="text-gray-600 text-sm">Configure the values used for pace and heart rate zone analysis.</p>
        </div>

        <div class="p-4">
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded mb-3 flex justify-between items-center">
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="text-green-600 hover:text-green-800">✕</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-3 flex justify-between items-center">
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800">✕</button>
                </div>
            {% endfor %}

            <form method="post" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                
                <div>
                    <label for="treshold_minutes_per_kilometer" class="block text-xs font-semibold text-gray-600 mb-2">Treshold (minutes per kilometer)</label>
                    <input
                        type="number"
                        step="0.01"
                        min="0"
                        class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none"
                        id="treshold_minutes_per_kilometer"
                        name="treshold_minutes_per_kilometer"
                        value="{{ treshold is null ? '' : treshold.value }}"
                        placeholder="e.g. 4.50"
                    >
                    <p class="text-gray-600 text-xs mt-1">Used to calculate pace zones for running activities.</p>
                </div>

                <div>
                    <label for="max_heart_rate" class="block text-xs font-semibold text-gray-600 mb-2">Max heart rate (bpm)</label>
                    <input
                        type="number"
                        step="1"
                        min="1"
                        class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none"
                        id="max_heart_rate"
                        name="max_heart_rate"
                        value="{{ maxHeartRate.isValid() ? maxHeartRate.bpm : '' }}"
                        placeholder="e.g. 180"
                    >
                    <p class="text-gray-600 text-xs mt-1">Used to calculate heart rate zones when stream data includes heart rate.</p>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 pt-3 border-t border-gray-200">
                    <button type="submit" class="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold rounded transition">
                        Save settings
                    </button>
                    <button type="button" onclick="resetCache()" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-sm font-semibold rounded transition">
                        Reset cache
                    </button>
                    <a href="{{ path('activities_index') }}" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-900 text-sm font-semibold rounded transition text-center no-underline">
                        Back to activities
                    </a>
                </div>
            </form>

            <div class="bg-gray-50 rounded border border-gray-200 p-3 mt-4">
                <div class="font-semibold text-sm mb-2 text-gray-700">Current values</div>
                <div class="text-sm space-y-1 text-gray-600">
                    <div><span>Treshold:</span> <span class="font-semibold text-gray-900">{{ treshold }}</span></div>
                    <div><span>Max heart rate:</span> <span class="font-semibold text-gray-900">{{ maxHeartRate is null ? 'Not set' : maxHeartRate }}</span></div>
                </div>
            </div>
        </div>
    </section>
</main>

{% include 'components/_footer.html.twig' %}

<script>
function resetCache() {
    if (confirm('Are you sure you want to reset the cache? This will delete all cached activities.')) {
        fetch('{{ path("activities_clear") }}', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => {
            if (response.ok) {
                return response.json();
            }
            throw new Error('Failed to reset cache');
        })
        .then(data => {
            alert('Cache reset successfully');
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error resetting cache: ' + error.message);
        });
    }
}
</script>
{% endblock %}
