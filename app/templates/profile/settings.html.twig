<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Settings - Momentum</title>
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; }
        .settings-shell { max-width: 760px; margin: 0 auto; padding: 2rem 1rem; }
        .settings-card { background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,.08); overflow: hidden; }
        .settings-header { padding: 1.5rem 1.5rem 0; }
        .settings-body { padding: 1.5rem; }
        .hint { color: #6c757d; font-size: .95rem; }
        .value-preview { background: #f8f9fa; border-radius: 10px; padding: 1rem; }
    </style>
</head>
<body>
    {% include 'components/_header.html.twig' %}

    <main class="settings-shell">
        <section class="settings-card">
            <div class="settings-header">
                <h1 class="h3 mb-2">Profile settings</h1>
                <p class="hint mb-0">Configure the values used for pace and heart rate zone analysis.</p>
            </div>

            <div class="settings-body">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}

                <form method="post" class="row g-3">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <div class="col-12">
                        <label for="ftp_minutes_per_kilometer" class="form-label">FTP (minutes per kilometer)</label>
                        <input
                            type="number"
                            step="0.01"
                            min="0"
                            class="form-control"
                            id="ftp_minutes_per_kilometer"
                            name="ftp_minutes_per_kilometer"
                            value="{{ ftp is null ? '' : ftp.value }}"
                            placeholder="e.g. 4.25"
                        >
                        <div class="form-text">Used to calculate pace zones for running activities.</div>
                    </div>

                    <div class="col-12">
                        <label for="max_heart_rate" class="form-label">Max heart rate</label>
                        <input
                            type="number"
                            step="1"
                            min="1"
                            class="form-control"
                            id="max_heart_rate"
                            name="max_heart_rate"
                            value="{{ maxHeartRate ?? '' }}"
                            placeholder="e.g. 190"
                        >
                        <div class="form-text">Used to calculate heart rate zones when stream data includes heart rate.</div>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary">Save settings</button>
                        <a href="{{ path('activities') }}" class="btn btn-outline-secondary">Back to activities</a>
                    </div>
                </form>

                <div class="value-preview mt-4">
                    <strong>Current values</strong>
                    <div class="mt-2">
                        <div>FTP: {{ ftp }}</div>
                        <div>Max heart rate: {{ maxHeartRate is null ? 'Not set' : maxHeartRate ~ ' bpm' }}</div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
