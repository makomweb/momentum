{% extends "base.html.twig" %}

{% block title %}Profile Settings - Momentum{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<main class="max-w-2xl mx-auto px-4 py-8 flex-grow">
    <section class="bg-white rounded border border-gray-200 max-w-2xl w-full">
        <div class="border-b border-gray-200 p-4">
            <h1 class="text-2xl font-bold mb-1">{{ 'settings.title'|trans }}</h1>
            <p class="text-gray-600 text-sm">{{ 'settings.subtitle'|trans }}</p>
        </div>

        <div class="p-4">
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded mb-3 flex justify-between items-center">
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="text-green-600 hover:text-green-800">✕</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-3 flex justify-between items-center">
                    <span>{{ message }}</span>
                    <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800">✕</button>
                </div>
            {% endfor %}

            <!-- Language Section -->
            <div class="mb-6 pb-6 border-b border-gray-200">
                <label class="block text-xs font-semibold text-gray-600 mb-3">{{ 'settings.language'|trans }}</label>
                <div class="flex gap-2">
                    <a href="{{ path('set_locale', {lang: 'en'}) }}" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-900 text-sm font-semibold rounded transition">
                        🇬🇧 English
                    </a>
                    <a href="{{ path('set_locale', {lang: 'de'}) }}" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-900 text-sm font-semibold rounded transition">
                        🇩🇪 Deutsch
                    </a>
                </div>
            </div>

            <form method="post" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                
                <div>
                    <label for="run_treshold_per_kilometer" class="block text-xs font-semibold text-gray-600 mb-2">{{ 'settings.run_threshold_label'|trans }}</label>
                    <input
                        type="number"
                        step="0.01"
                        min="0"
                        class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none"
                        id="run_treshold_per_kilometer"
                        name="run_treshold_per_kilometer"
                        value="{{ run_treshold is null ? '' : run_treshold.value }}"
                        placeholder="e.g. 4.50"
                    >
                    <p class="text-gray-600 text-xs mt-1">{{ 'settings.run_threshold_help'|trans }}</p>
                </div>
                
                <div>
                    <label for="cycling_treshold_watt" class="block text-xs font-semibold text-gray-600 mb-2">{{ 'settings.cycling_threshold_label'|trans }}</label>
                    <input
                        type="number"
                        step="1"
                        min="0"
                        class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none"
                        id="cycling_treshold_watts"
                        name="cycling_treshold_watts"
                        value="{{ cycling_treshold is null ? '' : cycling_treshold.watts }}"
                        placeholder="e.g. 120"
                    >
                    <p class="text-gray-600 text-xs mt-1">{{ 'settings.cycling_threshold_help'|trans }}</p>
                </div>

                <div>
                    <label for="max_heart_rate" class="block text-xs font-semibold text-gray-600 mb-2">{{ 'settings.max_heart_rate_label'|trans }}</label>
                    <input
                        type="number"
                        step="1"
                        min="1"
                        class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none"
                        id="max_heart_rate"
                        name="max_heart_rate"
                        value="{{ max_heart_rate.isValid() ? max_heart_rate.bpm : '' }}"
                        placeholder="e.g. 180"
                    >
                    <p class="text-gray-600 text-xs mt-1">{{ 'settings.max_heart_rate_help'|trans }}</p>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 pt-3 border-t border-gray-200">
                    <button type="submit" class="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold rounded transition">
                        {{ 'settings.save_button'|trans }}
                    </button>
                    <button type="button" onclick="resetCache()" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-sm font-semibold rounded transition">
                        {{ 'settings.reset_cache_button'|trans }}
                    </button>
                    <a href="{{ path('activities_index') }}" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-900 text-sm font-semibold rounded transition text-center no-underline">
                        {{ 'settings.back_button'|trans }}
                    </a>
                </div>
            </form>

            <div class="bg-gray-50 rounded border border-gray-200 p-3 mt-4">
                <div class="font-semibold text-sm mb-2 text-gray-700">{{ 'settings.current_values'|trans }}</div>
                <div class="text-sm space-y-1 text-gray-600">
                    <div><span>{{ 'settings.run_threshold'|trans }}</span> <span class="font-semibold text-gray-900">{{ run_treshold }}</span></div>
                    <div><span>{{ 'settings.cycling_threshold'|trans }}</span> <span class="font-semibold text-gray-900">{{ cycling_treshold }}</span></div>
                    <div><span>{{ 'settings.max_heart_rate'|trans }}</span> <span class="font-semibold text-gray-900">{{ max_heart_rate is null ? ('settings.not_set'|trans) : max_heart_rate }}</span></div>
                </div>
            </div>
        </div>
    </section>
</main>

{% include 'components/_footer.html.twig' %}

<script>
function resetCache() {
    if (confirm('{{ 'settings.reset_confirm'|trans }}')) {
        fetch('{{ path("activities_clear") }}', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => {
            if (response.ok) {
                return response.json();
            }
            throw new Error('Failed to reset cache');
        })
        .then(data => {
            alert('{{ 'settings.reset_success'|trans }}');
        })
        .catch(error => {
            console.error('Error:', error);
            alert('{{ 'settings.reset_error'|trans }}' + error.message);
        });
    }
}
</script>
{% endblock %}
