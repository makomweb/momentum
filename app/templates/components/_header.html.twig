<header class="sticky top-0 z-10 bg-white border-b">
    <nav class="flex items-center justify-between px-6 py-4">
        <a href="{{ path('activities') }}" class="font-bold text-lg no-underline">
            Momentum
        </a>
        
        {% if app.user %}
            {% set user = app.user %}
            {% set profile_picture = user.profilePictureMedium %}
            
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    {% if profile_picture %}
                        <img src="{{ profile_picture }}" alt="{{ user.name }}" class="w-8 h-8 rounded-full object-cover">
                    {% else %}
                        <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center text-white text-sm">👤</div>
                    {% endif %}
                    <div class="text-sm">
                        <div class="font-medium">{{ user.name }}</div>
                        <div class="text-gray-500 text-xs">{{ user.stravaId }}</div>
                    </div>
                </div>

                <a href="{{ path('profile_settings') }}" class="text-sm hover:underline">Settings</a>
                
                <form method="post" action="{{ path('logout') }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="text-sm hover:underline">Logout</button>
                </form>
            </div>
        {% endif %}
    </nav>
</header>
