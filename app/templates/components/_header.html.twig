<header class="sticky top-0 z-100 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="{{ path('activities') }}" class="font-bold text-xl text-gray-900 no-underline">
            Momentum
        </a>
        
        {% if app.user %}
            {% set user = app.user %}
            {% set profile_picture = user.profilePictureMedium %}
            
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3">
                    {% if profile_picture %}
                        <img src="{{ profile_picture }}" alt="{{ user.name }}" class="w-10 h-10 rounded-full object-cover" title="{{ user.name }}">
                    {% else %}
                        <div class="w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center text-white text-lg">👤</div>
                    {% endif %}
                    <div>
                        <div class="font-medium text-gray-900">{{ user.name }}</div>
                        <small class="text-gray-600">ID: {{ user.stravaId }}</small>
                    </div>
                </div>

                <a href="{{ path('profile_settings') }}" class="px-4 py-2 bg-transparent border border-gray-300 rounded text-gray-900 no-underline text-sm hover:bg-gray-50 transition">Settings</a>
                
                <form method="post" action="{{ path('logout') }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded text-sm transition cursor-pointer border-none">Logout</button>
                </form>
            </div>
        {% endif %}
    </div>
</header>
