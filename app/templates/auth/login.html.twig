<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Momentum</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-500 to-purple-600 flex flex-col min-h-screen">
    <main class="w-full max-w-sm mx-auto px-4 py-8 flex-grow flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-2xl w-full p-8 text-center">
            <img src="{{ asset('images/logo.png') }}" alt="Momentum logo" class="max-w-32 h-auto mx-auto mb-4">
            <h1 class="text-3xl font-bold mb-2">Momentum</h1>
            <p class="text-gray-600 mb-6">Analyze your Strava activities</p>

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 mb-4 rounded text-left text-sm">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-4 mb-4 rounded text-left text-sm">
                    {{ message }}
                </div>
            {% endfor %}

            <form method="POST" action="{{ path('authorize_strava') }}" class="space-y-4">
                <div class="flex items-center gap-2">
                    <input type="checkbox" name="_remember_me" id="remember_me" value="1" checked class="w-4 h-4 text-indigo-600 rounded">
                    <label for="remember_me" class="text-sm text-gray-700 cursor-pointer">Keep me logged in for 30 days</label>
                </div>

                <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-lg transition duration-200">
                    Login with Strava
                </button>
            </form>

            <div class="bg-blue-50 border-l-4 border-blue-500 text-blue-900 p-4 rounded mt-6 text-left text-sm">
                <strong class="block mb-2">ℹ️ What we need:</strong>
                <p>We'll request access to your activities. Your data is used only for syncing your activities to Momentum.</p>
            </div>
        </div>
    </main>

    {% include 'components/_footer.html.twig' %}
</body>
</html>
