{% extends "base.html.twig" %}

{% block title %}About - Momentum{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<main class="max-w-2xl mx-auto px-4 py-8 flex-grow">
    <section class="bg-white rounded border border-gray-200">
        <div class="border-b border-gray-200 p-4">
            <h1 class="text-2xl font-bold mb-1">About Momentum</h1>
            <p class="text-gray-600 text-sm">Learn more about this project and how it works.</p>
        </div>

        <div class="p-4 space-y-4">
            <div>
                <h2 class="text-sm font-semibold mb-2">What is Momentum?</h2>
                <p class="text-gray-700 text-sm">
                    Momentum is an open-source activity analysis tool that integrates with the Strava API to provide detailed insights into your running, cycling, swimming, and other athletic activities. It tracks training zones, heart rate patterns, and helps you understand your workout distribution.
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">Features</h2>
                <ul class="text-gray-700 text-sm space-y-1 list-disc list-inside">
                    <li>Heart rate zone analysis</li>
                    <li>Pace zone tracking for runners</li>
                    <li>Training metrics and insights</li>
                    <li>Activity stream visualization</li>
                    <li>Customizable zone configurations</li>
                </ul>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">License</h2>
                <p class="text-gray-700 text-sm">
                    Momentum is released under the <strong>MIT License</strong>. This is a permissive open-source license that allows you to use, modify, and distribute the software freely.
                    <a href="https://opensource.org/licenses/MIT" class="text-sky-600 hover:underline" target="_blank">Read the full license</a>.
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">Data Privacy</h2>
                <p class="text-gray-700 text-sm">
                    Momentum <strong>only reads</strong> your activity data from Strava. It does not modify, delete, or alter any data on your Strava account. Your activities are analyzed locally to provide insights without any changes being made to Strava.
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">Technology</h2>
                <p class="text-gray-700 text-sm">
                    Built with <strong>Symfony 8</strong>, <strong>Tailwind CSS</strong>, <strong>Doctrine ORM</strong>, and the <strong>Strava API</strong>. Hosted and managed locally or on your own infrastructure.
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">Open Source</h2>
                <p class="text-gray-700 text-sm">
                    Momentum is completely open source and free to use. The source code is available on GitHub, and community contributions are welcome. Join us in improving activity analysis for athletes everywhere.
                </p>
            </div>

            <div class="pt-4 border-t border-gray-200">
                <a href="{{ path('activities_index') }}" class="inline-block px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold rounded transition">
                    Back to activities
                </a>
            </div>
        </div>
    </section>
</main>

{% include 'components/_footer.html.twig' %}
{% endblock %}
