{% extends "base.html.twig" %}

{% block title %}About - Momentum{% endblock %}

{% block body_class %}class="bg-gray-50 flex flex-col min-h-screen"{% endblock %}

{% block body %}
{% include 'components/_header.html.twig' %}

<main class="max-w-2xl mx-auto px-4 py-8 flex-grow">
    <section class="bg-white rounded border border-gray-200">
        <div class="border-b border-gray-200 p-4">
            <h1 class="text-2xl font-bold mb-1">{{ 'about.title'|trans }}</h1>
            <p class="text-gray-600 text-sm">{{ 'about.subtitle'|trans }}</p>
        </div>

        <div class="p-4 space-y-4">
            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.what_is'|trans }}</h2>
                <p class="text-gray-700 text-sm">
                    {{ 'about.description'|trans }}
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.features'|trans }}</h2>
                <ul class="text-gray-700 text-sm space-y-1 list-disc list-inside">
                    <li>{{ 'about.feature_1'|trans }}</li>
                    <li>{{ 'about.feature_2'|trans }}</li>
                    <li>{{ 'about.feature_3'|trans }}</li>
                    <li>{{ 'about.feature_4'|trans }}</li>
                    <li>{{ 'about.feature_5'|trans }}</li>
                </ul>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.license'|trans }}</h2>
                <p class="text-gray-700 text-sm">
                    {{ 'about.license_text'|trans }} <strong>{{ 'about.license_name'|trans }}</strong>{{ 'about.license_info'|trans }}
                    <a href="https://opensource.org/licenses/MIT" class="text-sky-600 hover:underline" target="_blank">{{ 'about.read_license'|trans }}</a>.
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.privacy'|trans }}</h2>
                <p class="text-gray-700 text-sm">
                    {{ 'about.privacy_text_1'|trans }} <strong>{{ 'about.privacy_text_2'|trans }}</strong> {{ 'about.privacy_text_3'|trans }}
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.technology'|trans }}</h2>
                <p class="text-gray-700 text-sm">
                    {{ 'about.built_with'|trans }} <strong>{{ 'about.tech_1'|trans }}</strong>, <strong>{{ 'about.tech_2'|trans }}</strong>, <strong>{{ 'about.tech_3'|trans }}</strong>, {{ 'about.tech_4'|trans }}{{ 'about.tech_info'|trans }}
                </p>
            </div>

            <div>
                <h2 class="text-sm font-semibold mb-2">{{ 'about.open_source'|trans }}</h2>
                <p class="text-gray-700 text-sm">
                    {{ 'about.open_source_text'|trans }}
                </p>
            </div>

            <div class="pt-4 border-t border-gray-200">
                <a href="{{ path('activities_index') }}" class="inline-block px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold rounded transition">
                    {{ 'about.back_to_activities'|trans }}
                </a>
            </div>
        </div>
    </section>
</main>

{% include 'components/_footer.html.twig' %}
{% endblock %}
