# Local Development Configuration Template
# INSTRUCTIONS:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in all empty values below with your configuration
# 3. NEVER commit .env.local to git

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-unique-app-secret-here
APP_VERSION=development
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker Compose database connection
DATABASE_URL=mysql://root:secret@db:3306/app?serverVersion=8.4&charset=utf8mb4
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Docker Compose messenger transport
MESSENGER_TRANSPORT_DSN=doctrine://default?table_name=messenger_messages&queue_name=default
###< symfony/messenger ###

###> symfony/cache ###
# Docker Compose Redis cache
CACHE_URL=redis://cache:6379
###< symfony/cache ###

###> Strava OAuth Configuration ###
# Get these credentials from: https://www.strava.com/settings/api
# REQUIRED: Must be filled in for Strava integration to work
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/exchange-token
###< Strava OAuth Configuration ###

###> Security Cookies ###
SECURE_COOKIE=false
###< Security Cookies ###
