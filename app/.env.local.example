# Copy this file to .env.local and add your Strava API credentials
# DO NOT commit .env.local to version control

###> Strava OAuth Configuration ###
# Get these credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-client-id-here
STRAVA_CLIENT_SECRET=your-client-secret-here
STRAVA_REDIRECT_URI=http://localhost:8080/exchange-token
###< Strava OAuth Configuration ###
