# Disable auto HTTPS - let Kubernetes Ingress/cert-manager handle TLS certificates
{
    auto_https off
}

# HTTP to HTTPS redirect for any domain (production)
http:// {
    redir https://{host}{uri} permanent
}

# Main app - serves both HTTP (from redirect) and HTTPS (from Kubernetes Ingress)
# Listen on all hosts (Kubernetes/NodePort uses server IP as Host header)
# NOTE: This port (80/443) does NOT serve /health/* endpoints (they're on internal port 8081)
:443, :80 {
    root * /app/public
    encode gzip
    # php_server routes ALL requests to PHP
    # Symfony application routing (@Route) determines what gets handled
    php_server
}

# Internal health check endpoints - ONLY accessible from within the cluster
# Kubelet probes connect directly to this port (bypasses Ingress, no internet access)
# 
# How routing works:
#   1. Kubelet makes request: GET http://pod-ip:8081/health/live
#   2. Caddy listens on :8081 and passes request to php_server
#   3. Symfony Router matches the request to HealthController (via @Route("/health/live"))
#   4. HealthController::liveness() returns JSON response
#
# These requests:
# - Are NOT subject to rate limiting (RateLimiter listener skips /health/*)
# - Are NOT reachable from the internet (only accessible internally in cluster)
# - Are NOT exposed via Kubernetes Service or Ingress
# - Provide zero DDoS attack surface
#
:8081 {
    root * /app/public
    encode gzip
    php_server
}

# Development fallback on port 8080 (no HTTPS needed locally)
# Used for local docker-compose development
:8080 {
    root * /app/public
    encode gzip
    php_server
}
