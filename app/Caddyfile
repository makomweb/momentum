# Disable auto HTTPS - let Kubernetes Ingress/cert-manager handle TLS certificates
{
    auto_https off
}

# Main app - serves public traffic on port 8080
# In production: Kubernetes Ingress handles TLS termination on :443
# This container only needs to listen on :8080 and :8081
# Health endpoints are explicitly blocked here
:8080 {
    # Block health endpoints on public port - they're ONLY for internal :8081
    # This prevents attackers from reaching /health/* via internet-facing port
    @health_path {
        path /health/*
    }
    
    # REJECT health check requests - they're only for internal use on :8081
    handle @health_path {
        respond "Not Found" 404
    }
    
    root * /app/public
    encode gzip
    php_server
}

# Internal health check endpoints - ONLY accessible from within the cluster
# Kubelet probes connect directly to this port (bypasses Ingress, no internet access)
# 
# How routing works:
#   1. Kubelet makes request: GET http://pod-ip:8081/health/live
#   2. Caddy listens on :8081 and passes request to php_server
#   3. Symfony Router matches the request to HealthController (via @Route("/health/live"))
#   4. HealthController::liveness() returns JSON response
#
# These requests:
# - Are NOT subject to rate limiting (RateLimiter listener skips /health/*)
# - Are NOT reachable from the internet (blocked on :8080, only on :8081)
# - Are NOT exposed via Kubernetes Service or Ingress
# - Provide ZERO DDoS attack surface
#
:8081 {
    root * /app/public
    encode gzip
    php_server
}
